(ns test.sfx-test
  "The sound mode M cycles. The tests run on a stock lg, with no audio, so
   this covers the mode bookkeeping, not what plays."
  (:require [clojure.test :refer [deftest is]]
            [tesserae.sfx :as sfx]))

(deftest m-cycles-every-mode-and-wraps
  (sfx/set-mode! :all)
  (is (= [:sfx :music :off :all] (vec (repeatedly 4 sfx/cycle-mode!))))
  (is (= :all @sfx/mode)))

(deftest without-audio-nothing-starts
  (sfx/start! {:sound :off})
  (is (not @sfx/on?) "no backend, so M has nothing to switch")
  (sfx/set-mode! :all))
