(ns test.world-test
  "Tetromino packing determinism and level map validity."
  (:require [clojure.test :refer [deftest is testing]]
            [tesserae.world :as w]
            [tesserae.levels :as L]))

(defn- snapshot [] [(vec w/tt) (vec w/tpiece) (vec w/tkind) (vec w/tbase)])

(defn- count-where-i [pred] (count (w/indices-where-i pred)))

(defn- load! [l seed] (w/load-map! (:map l) (get L/themes (:theme l)) seed))

(deftest packing-is-deterministic
  (doseq [l (filter #(re-find #"\?|," (apply str (:map %))) L/levels)]
    (testing (:id l)
      (load! l 42)
      (let [a (snapshot)]
        (load! l 42)
        (is (= a (snapshot)) "same seed, same packing")
        (load! l 43)
        (is (not= (rest a) (rest (snapshot))) "another seed, another packing")))))

(defn goal-count
  "What the level's :goal asks for, counted on the freshly loaded world."
  [l]
  (case (:goal l)
    (:clear :heart) (w/count-where w/breakable?)
    :build (w/count-where #(= % w/GHOST))
    :lamps (w/count-where #(= % w/LAMP))
    :core (if (pos? (w/count-where #(= % w/CORE))) (get-in l [:core :hp] 0) 0)
    ;; the Orrery: marbles to place plus bits to set
    :orrery (+ (reduce + (vals (get-in l [:orrery :cups]))) (count (get-in l [:orrery :target])))
    ;; goal kinds this test does not know yet: something must be there to play for
    (w/count-where #(and (pos? %) (not= % w/WALL) (not= % w/PIT)))))

(deftest maps-are-valid
  (doseq [[j l] (map-indexed vector (concat L/levels [L/title-level] L/special-levels))]
    (testing (str (:id l) " " (:name l))
      (is (= 24 (count (:map l))) "24 rows")
      (is (every? #(= 24 (count %)) (:map l)) "24 cols per row")
      (let [{:keys [starts]} (load! l (+ 11 j))]
        (is (pos? (goal-count l)) "goal count > 0 after load")
        (when (and (or (:tilt l) (:ward l)) (not (:orrery l)))
          (is (seq starts) "ball starts (B) present"))))))

(deftest orrery-levels-are-wired
  (doseq [[j l] (map-indexed vector L/levels) :when (:orrery l)]
    (testing (:id l)
      (load! l (+ 11 j))
      (let [c (:orrery l)
            at (fn [[x y]] (aget w/tt (+ x (* y w/G))))]
        (is (= 1 (w/count-where #(= % w/HOPPER))) "one hopper")
        (is (= 1 (w/count-where #(= % w/ESCAPE))) "one escapement")
        (is (pos? (:marbles c 0)) "marbles in the hopper")
        (is (:bonus l) "the Orrery is the bonus chapter")
        (doseq [k (keys (:cups c))]
          (is (pos? (count-where-i #(and (= w/CUP (aget w/tt %)) (= (int k) (aget w/tkind %)))))
              (str "a " k " cup on the map")))
        (doseq [p (concat (:register c) (apply concat (:gears c)))]
          (is (= w/BIT (at p)) (str p " is a bit")))
        (is (= (count (:register c)) (count (:target c))) "target as long as the register")
        (is (= (count (:solution c)) (:marbles c)) "a lean per marble in the solution")))))

(deftest bonus-chapter-is-last
  (let [bonus (map :bonus L/levels)]
    (is (= bonus (sort-by #(if % 1 0) bonus)) "bonus levels come after every main level")))

(deftest levels-have-metadata
  (is (= (count L/levels) (count (distinct (map :id L/levels)))) "level ids are unique")
  (doseq [l (concat L/levels L/special-levels)]
    (testing (:id l)
      (is (and (number? (:par l)) (pos? (:par l))) "a positive :par (seconds)")
      (is (contains? L/themes (:theme l))))))

(deftest special-levels-are-apart
  (doseq [l L/special-levels]
    (testing (:id l)
      (is (not-any? #(= (:id l) (:id %)) L/levels) "a special id is not a numbered level's")
      (is (= l (L/special-level (:id l))) "found by id")
      (when (:hmap l)
        (is (= 24 (count (:hmap l))) "24 hmap rows")
        (is (every? #(= 24 (count %)) (:hmap l)) "24 hmap cols per row")))))
