(ns tesserae.levels
  "Story, chapters and the levels. A map is 24 strings of 24 chars, or a
   generator fn (x y) -> char. Legend:
     .  empty           ?  tetromino fill (breakable, packed per seed)
     ,  ghost fill      IOTSZJL breakable piece / iotszjl ghost piece
     H  hard (2 hits)   #  wall          +  mitosis   *  rubber   %  lead
     @  lodestone       x  pit           $  lamp      B  ball / marble start
     =  grout shield    C  the Grout Core   ^  glass ball   ~  ghost ball
   The Orrery (VII), marble logic parts:
     V  hopper (SPACE drops a marble)   e  escapement (waits for the table to lean)
     0 1  bit, sending marbles right (0) / left (1), flipping each pass
     > <  fixed ramp    X  crossover    b r g  blue / red / gold cup")

(def prologue
  ["Above the world hangs the Mosaic: ten thousand living tesserae, each a shard of the sky's memory."
   ""
   "Then the Grout came. Grey, patient, hungry, it seeped between the tiles and set them hard as bone."
   ""
   "You are the last Lapidary. You carry a Trowel and a Spark."
   ""
   "Break what is dead. Set what is lost. Turn the sky."])

(def orrery-teaser
  [""
   "Far beneath, something brass begins to tick."
   ""
   "(A new chapter is open on the title screen: VII · THE ORRERY.)"])

(def orrery-coda
  ["The Orrery counts again."
   ""
   "One, and one, and one: the old arithmetic of the sky, carried in brass and glass."
   ""
   "Above, the Mosaic turns, and for the first time in an age it knows what hour it is."])

(def epilogue
  ["The last course falls."
   ""
   "The Mosaic turns once, freely, and the sky remembers its colours."
   ""
   "Somewhere below, a Lapidary sets down the Trowel."
   ""
   "For now."])

;; ---------------------------------------------------------------------------
;; map helpers

(defn gen [f]
  (vec (for [y (range 24)] (apply str (for [x (range 24)] (f x y))))))

(defn- line-cells
  "Bresenham cells between two tile points."
  [[x0 y0] [x1 y1]]
  (let [dx (math/abs (- x1 x0)) dy (- (math/abs (- y1 y0)))
        sx (if (< x0 x1) 1 -1) sy (if (< y0 y1) 1 -1)]
    (loop [x x0 y y0 err (+ dx dy) acc #{}]
      (let [acc (conj acc [x y])]
        (if (and (= x x1) (= y y1)) acc
            (let [e2 (* 2 err)
                  [x err] (if (>= e2 dy) [(+ x sx) (+ err dy)] [x err])
                  [y err] (if (<= e2 dx) [(+ y sy) (+ err dx)] [y err])]
              (recur x y err acc)))))))

(defn- polyline [& pts]
  (reduce into #{} (map line-cells pts (rest pts))))

(defn- manhattan [x y] (+ (math/abs (- x 11.5)) (math/abs (- y 11.5))))
(defn- dist [x y cx cy] (math/sqrt (+ (* (- x cx) (- x cx)) (* (- y cy) (- y cy)))))

;; ---------------------------------------------------------------------------
;; maps

(defn ring-path
  "Tile cells of the perimeter of box [x0 y0 x1 y1], clockwise from the
   top-left corner. The Grout Core's shield scrolls along this path."
  [[x0 y0 x1 y1]]
  (vec (concat (for [x (range x0 (inc x1))] [x y0])
               (for [y (range (inc y0) (inc y1))] [x1 y])
               (for [x (range (dec x1) (dec x0) -1)] [x y1])
               (for [y (range (dec y1) y0 -1)] [x0 y]))))

(def map-first-light
  (gen (fn [x y] (if (and (<= 2 y 7) (<= 2 x 21)) \? \.))))

(def map-mitosis
  ["........................"
   "..HHHHHHHHHHHHHHHHHHHH.."
   "..H??????????????????H.."
   "..H???+?^??????+?????H.."
   "..H??????????????????H.."
   "..H?????+??????+?????H.."
   "..H??????????????????H.."
   "..HHHHHHHH....HHHHHHHH.."
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................"])

(def map-quarter-turn
  (let [mito #{[11 6] [6 12] [17 11] [12 17]}]
    (gen (fn [x y]
           (let [d (manhattan x y)]
             (cond (<= d 1) \#
                   (contains? mito [x y]) \+
                   (<= d 7) \?
                   :else \.))))))

(def map-twin
  (gen (fn [x y]
         (cond (and (= y 11) (<= 9 x 14)) \#
               (contains? #{[5 10] [18 13]} [x y]) \+
               (= [x y] [11 8]) \*
               (and (<= 8 y 15) (<= 3 x 20)) \?
               :else \.))))

(def map-blueprint
  (let [crown (polyline [3 12] [20 12] [20 4] [16 8] [12 3] [11 3] [7 8] [3 4] [3 12])
        gems #{[7 15] [11 16] [12 16] [16 15]}]
    (gen (fn [x y] (cond (contains? crown [x y]) \,
                         (contains? gems [x y]) \,
                         :else \.)))))

(def map-grout
  (let [ring (set (for [x (range 24) y (range 24)
                        :let [d (dist x y 7 8)]
                        :when (and (>= d 3.4) (< d 4.5))] [x y]))
        shaft (polyline [12 8] [21 8])
        teeth (polyline [17 9] [17 10])
        teeth2 (polyline [20 9] [20 11])]
    (gen (fn [x y] (if (or (ring [x y]) (shaft [x y]) (teeth [x y]) (teeth2 [x y])) \, \.)))))

(def map-tilt
  ["########################"
   "#B.....#........x.....$#"
   "#.....##........x......#"
   "#..$.....###.......##..#"
   "#........#.....$....#..#"
   "###..x...#..........#..#"
   "#........#...xx.....x..#"
   "#..####..#..........#..#"
   "#.....#.....#####......#"
   "#.$...#.........#...$..#"
   "#.....#..x......#......#"
   "#..x..######....#...####"
   "#..............x.......#"
   "#####.....$............#"
   "#.......####..###...x..#"
   "#..x....#.......#......#"
   "#.......#...$...#..$...#"
   "#...$...#.......#......#"
   "#.......###...###...x..#"
   "#..##..........x.......#"
   "#..##....x.........##..#"
   "#...........$......##..#"
   "#x.......x.......x....$#"
   "########################"])

(def map-marble-run
  ["########################"
   "#B........$..........B.#"
   "#.??????.......??????..#"
   "#.?....?..xx...?....?..#"
   "#.?.$..?.......?..$.?..#"
   "#.?....?...$...?....?..#"
   "#.??..??.......??..??..#"
   "#......................#"
   "#..x.......B........x..#"
   "#......................#"
   "#...#####......#####...#"
   "#...#..$#..xx..#$..#...#"
   "#...#...#......#...#...#"
   "#...##.##..$...##.##...#"
   "#......................#"
   "#.x..................x.#"
   "#.......??????????.....#"
   "#.......?..$..$..?.....#"
   "#.......?........?.....#"
   "#.......????..????.....#"
   "#..$...............$...#"
   "#....x.....xx.....x....#"
   "#$....................$#"
   "########################"])

(def map-lodestone
  ["........................"
   "..????????????????????.."
   "..????????????????????.."
   "..??%??????~??????*???.."
   "..????????????????????.."
   "........................"
   ".....@..........@......."
   "........................"
   "...........@............"
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................" "........................" "........................"
   "........................" "........................" "........................"])

(def map-heart
  (let [gaps #{[5 0] [17 0] [0 8] [23 15] [6 23] [16 23]}
        mito #{[8 11] [15 12]}]
    (gen (fn [x y]
           (let [d (dist x y 11.5 11.5)
                 border? (or (= x 0) (= y 0) (= x 23) (= y 23))]
             (cond (gaps [x y]) \.
                   border? \#
                   (= [x y] [11 11]) \B
                   (< d 1.6) \.
                   (mito [x y]) \+
                   (<= d 6.2) \?
                   :else \.))))))

(def map-title
  ;; T E S S / E R A E in a 3x5 tile font, rows 3-7 and 10-14
  (let [font {\T ["###" ".#." ".#." ".#." ".#."]
              \E ["###" "#.." "##." "#.." "###"]
              \S ["###" "#.." "###" "..#" "###"]
              \R ["##." "#.#" "##." "#.#" "#.#"]
              \A [".#." "#.#" "###" "#.#" "#.#"]}
        colors "IOTSZJLI"
        place (fn [word y0 ci]
                (for [[n ch] (map-indexed vector word)
                      [dy row] (map-indexed vector (font ch))
                      [dx c] (map-indexed vector row)
                      :when (= c \#)]
                  [[(+ 3 (* n 5) dx) (+ y0 dy)] (nth colors (+ ci n))]))
        cells (into {} (concat (place "TESS" 3 0) (place "ERAE" 10 4)))]
    (gen (fn [x y] (get cells [x y] \.)))))

(def core-shield
  ;; an outer ring that mends itself and an inner half-arc that does not
  ;; :gap = initial empty slots (inclusive); :regen = mends itself
  {:rings [{:box [8 2 16 10] :dir 1 :step 0.4 :colour 0xb0a48e :gap [19 22] :regen true}
           {:box [10 4 14 8] :dir -1 :step 0.6 :colour 0x857a6a :gap [5 15]}]
   :regen 3.0})

(def map-grout-core
  (let [shield (set (for [{:keys [box gap]} (:rings core-shield)
                          [j c] (map-indexed vector (ring-path box))
                          :when (not (<= (first gap) j (second gap)))]
                      c))]
    (gen (fn [x y]
           (cond (and (<= 11 x 13) (<= 5 y 7)) \C
                 (shield [x y]) \=
                 :else \.)))))

;; the Mortar Well (3.3): a steel well, interior cols 8..15, rows 4..13, floor row 14,
;; with four open rows above its mouth for the Spark to cross
(def well-shape {:cols [8 15] :rows [4 13]})

(def map-mortar-well
  (gen (fn [x y]
         (cond (and (<= 4 y 14) (or (= x 7) (= x 16))) \#
               (and (= y 14) (<= 7 x 16)) \#
               (= [x y] [3 10]) \^
               (= [x y] [20 10]) \~
               (and (<= 9 y 10) (or (<= 1 x 5) (<= 18 x 22))) \?
               (and (= y 16) (<= 9 x 14)) \?
               :else \.))))

;; ---------------------------------------------------------------------------
;; the Orrery (VII): marble logic. Every marble drops from the hopper V into the
;; escapement e, which waits until the table leans left or right; it then rolls
;; off that end of the shelf. Parts act on a marble whose centre enters them;
;; rolling continues along any floor, and free marbles fall straight down.

;; 7.1 Escapement. Left: the ramp sends the marble along a short rail into the
;; blue cup. Right: the bit (starts 0, so right) alternates red, gold, red, gold.
;; Goal blue 1, red 2, gold 2 with 5 marbles.
;; Solution: right, right, right, right, left (the left one can come anywhere).
(def map-orrery-escapement
  ["########################"
   "#.........#V#..........#"
   "#......................#"
   "#..........e...........#"
   "#........#####.........#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#.............0........#"
   "#.............#........#"
   "#.......>..............#"
   "#........##............#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#..........b.g.r.......#"
   "########################"])

;; 7.2 Gearwork. Two bits on one axle, A (left, starts 0) and B (right, starts 1):
;; a marble through either flips both, so they always disagree.
;;   A 0 -> right -> through the crossover -> blue      A 1 -> left -> red
;;   B 0 -> right -> blue      B 1 -> left -> ramp, rail, across the crossover -> gold
;; So on even marbles (0, 2, 4) left = blue, right = gold; on odd ones left = red,
;; right = blue. Goal blue 3, red 1, gold 1 with 5 marbles.
;; Solution: left, left, right, right, left (blue, red, gold, blue, blue).
(def map-orrery-gearwork
  ["########################"
   "#.........#V#..........#"
   "#......................#"
   "#..........e...........#"
   "#........#####.........#"
   "#......................#"
   "#......................#"
   "#.......0.....1........#"
   "#.......#.....#........#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#........X...<.........#"
   "#.........####.........#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......rgb.....b.......#"
   "########################"])

;; 7.3 Counting House. A three-bit ripple counter, b2 b1 b0 on the staircase
;; (b0 top right). A bit at 0 turns to 1 and sends the marble right, out to the
;; gold tray; a bit at 1 turns to 0 and carries the marble left, down to the
;; next bit (b2's carry falls into the pit). The right lane enters at b0 (+1);
;; the left lane rides the ramp and rail into b1 (+2).
;; Goal: the bits read 1 0 1 (five) with only 3 marbles, so two of them must
;; count double. Solution: left, left, right (+2 +2 +1: 010, 100, 101).
(def map-orrery-counting
  ["########################"
   "#.........#V#..........#"
   "#......................#"
   "#..........e...........#"
   "#........#####.........#"
   "#......................#"
   "#.......>..............#"
   "#........####..........#"
   "#.............0........#"
   "#.............#........#"
   "#............0.........#"
   "#............#.........#"
   "#...........0..........#"
   "#...........#..........#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#..........x.ggg.......#"
   "########################"])

;; ---------------------------------------------------------------------------
;; themes

(def themes
  {:indigo {:bg0 0x0d0f24 :bg1 0x1a1240 :outside 0x05050c :accent 0x7f8cff}
   :teal   {:bg0 0x062024 :bg1 0x0b3438 :outside 0x020b0c :accent 0x4fe0d0}
   :umber  {:bg0 0x1e140c :bg1 0x2e1d10 :outside 0x0b0704 :accent 0xffc86a}
   :felt   {:bg0 0x0b2a16 :bg1 0x0f3a1e :outside 0x041008 :accent 0x9bea7a}
   :violet {:bg0 0x1a0b26 :bg1 0x2a1038 :outside 0x0a040e :accent 0xe070ff}
   :crimson {:bg0 0x24080e :bg1 0x380c14 :outside 0x0e0305 :accent 0xff5a6e}
   :grout  {:bg0 0x121014 :bg1 0x1e1a1c :outside 0x060506 :accent 0xff8a3c}
   :orrery {:bg0 0x0a0f20 :bg1 0x141a2e :outside 0x04050b :accent 0xe8c070}})

;; ---------------------------------------------------------------------------
;; chapters & levels

(def levels
  [{:id "1.1" :name "First Light" :chapter "I · THE CHIPPING" :theme :indigo :par 150
    :map map-first-light :goal :clear :speed 28.8
    :card ["The outer courses are fouled."
           ""
           "Strike them loose. The Spark remembers their colours even when they forget."
           ""
           "Clear a whole piece, all four tesserae, and it sings."]}
   {:id "1.2" :name "Mitosis" :chapter "I · THE CHIPPING" :theme :indigo :par 150
    :map map-mitosis :goal :clear :speed 30.0
    :card ["Some tiles are cells, still alive beneath the grout."
           ""
           "Touch one and the Spark divides."]}
   {:id "2.1" :name "Quarter Turn" :chapter "II · THE TURNING" :theme :teal :par 70
    :map map-quarter-turn :goal :clear :speed 28.8 :rotate 15.0
    :card ["The Mosaic was never meant to hold still. It is a dial, and the Grout has jammed it."
           ""
           "Free it and the sky turns under your feet."
           ""
           "Your Trowel stays where you stand. The world does not."]}
   {:id "2.2" :name "Twin Trowels" :chapter "II · THE TURNING" :theme :teal :par 90
    :map map-twin :goal :clear :speed 26.4 :rotate 18.0 :twin true :balls 2
    :card ["Two horizons. Two Trowels. One hand."
           ""
           "Both edges are open now. Both Trowels follow you."]}
   {:id "3.1" :name "Blueprint" :chapter "III · THE SETTING" :theme :umber :par 150
    :map map-blueprint :goal :build :speed 28.8
    :card ["Breaking is half the craft."
           ""
           "The blueprints still glimmer where the old tiles were. Strike a ghost and it sets, true and gold-rimmed."
           ""
           "Build the crown whole."]}
   {:id "3.2" :name "Grout Creep" :chapter "III · THE SETTING" :theme :umber :par 180
    :map map-grout :goal :build :speed 30.0 :decay 9.0 :balls 2
    :card ["The Grout fights back now, loosening what you set."
           ""
           "Finish the key faster than it forgets."]}
   {:id "3.3" :name "Mortar Well" :chapter "III · THE SETTING" :theme :umber :par 150
    :map map-mortar-well :goal :lines :speed 28.8
    :well (merge well-shape {:fall 0.8 :lines 5 :seek 12})
    :card ["Beneath the courses lies the Mortar Well, where the first masons poured the Mosaic's bed."
           ""
           "The Grout pours there still, one piece at a time, and where a piece comes to rest it sets."
           ""
           "Strike a falling piece on the side to shove it, from below to turn it. Lay a whole course and the Well takes it down."
           ""
           "Five courses. Do not let it fill to the brim."]}
   {:id "4.1" :name "Tilt Table" :chapter "IV · THE TILT" :theme :felt :par 120
    :map map-tilt :goal :lamps :tilt true
    :card ["Beneath the Mosaic lies the Orrery: a marble table of lamps and pits."
           ""
           "No Trowel here. Tilt the table and let gravity do the work."
           ""
           "Light every lamp. Mind the dark."]}
   {:id "4.2" :name "Marble Run" :chapter "IV · THE TILT" :theme :felt :par 150
    :map map-marble-run :goal :lamps :tilt true
    :card ["Three marbles, one table."
           ""
           "The tesserae here are soft. Knock them loose to reach the lamps inside."]}
   {:id "5.1" :name "Lodestone" :chapter "V · LODESTONE" :theme :violet :par 130
    :map map-lodestone :goal :clear :speed 31.2 :gravity 9.0 :magnet true
    :card ["Iron sleeps in the old foundation, and it pulls at the Spark."
           ""
           "So can you. SPACE wakes the Trowel's own lodestone: catch, aim, release."
           ""
           "Rubber bounds. Lead breaks through."]}
   {:id "6.1" :name "The Heart" :chapter "VI · THE HEART" :theme :crimson :par 110
    :map map-heart :goal :heart :speed 25.2 :ward true :boundary :open
    :card ["At the centre the Grout has walled the Spark inside its own heart."
           ""
           "You have no Trowel, only the tile the Mosaic lends you, and it will not stay lent for long."
           ""
           "Guard the breaches. Let the Spark eat its way out."]}
   {:id "6.2" :name "The Grout Core" :chapter "VI · THE HEART" :theme :grout :par 140
    :map map-grout-core :goal :core :speed 23.0
    :core {:hp 6}
    :shield core-shield
    :neutral {:rows [14 15]}
    :destroyer {:speed 5.5 :fall 5.0 :delay 3.0}
    :swirl {:every 12.0 :warn 1.2 :speed 36.0}
    :card ["Under the Heart the Grout keeps its Core, the first knot of mortar, the one that set all the others."
           ""
           "Its shield turns and mends itself. Its Destroyer hunts the Trowel. When the Core flares it will throw itself at you: step aside."
           ""
           "Between you runs a seam of raw colour. The Spark comes through it changed."
           ""
           "Break the Core."]}
   ;; VII · THE ORRERY: a bonus chapter, opened by clearing 6.2 (it unlocks in
   ;; list order like every level, but the run after 6.2 goes to the epilogue).
   ;; :orrery {:marbles n :fall g :cups {letter n} | :register [[x y] ..] :target "101"
   ;;          :gears [[[x y] [x y]] ..] :solution [-1 1 ..]}  (lean per marble, for --autoplay)
   {:id "7.1" :name "Escapement" :chapter "VII · THE ORRERY" :theme :orrery :par 45 :bonus true
    :map map-orrery-escapement :goal :orrery :tilt true
    :orrery {:marbles 5 :fall 30.0 :cups {\b 1 \r 2 \g 2} :solution [1 1 1 1 -1]}
    :card ["Beneath the Heart, beneath even the tilt tables, the Orrery still stands: the brass machine that once computed the sky."
           ""
           "The Grout never reached it. It simply forgot how to count."
           ""
           "SPACE drops a marble from the hopper. It waits in the escapement until you lean the table, left or right."
           ""
           "A bit sends each marble the way it leans, then flips. Fill the cups exactly."]}
   {:id "7.2" :name "Gearwork" :chapter "VII · THE ORRERY" :theme :orrery :par 60 :bonus true
    :map map-orrery-gearwork :goal :orrery :tilt true
    :orrery {:marbles 5 :fall 30.0 :cups {\b 3 \r 1 \g 1} :gears [[[8 7] [14 7]]]
             :solution [-1 -1 1 1 -1]}
    :card ["Two bits share an axle. Turn one and the other turns with it, so they never agree."
           ""
           "The crossover lets a rolling marble pass straight over a falling one."
           ""
           "Read the bits before you lean."]}
   {:id "7.3" :name "Counting House" :chapter "VII · THE ORRERY" :theme :orrery :par 60 :bonus true
    :map map-orrery-counting :goal :orrery :tilt true
    :orrery {:marbles 3 :fall 30.0 :register [[12 12] [13 10] [14 8]] :target "101"
             :solution [-1 -1 1]}
    :card ["Here the Orrery kept its count: three bits on a staircase, each one carrying into the next."
           ""
           "It must read five, 1 0 1, and the hopper holds only three marbles."
           ""
           "Not every lane counts the same."]}])

(def title-level
  {:id "--" :name "Attract" :chapter "" :theme :indigo :map map-title :goal :clear :speed 26.4})
