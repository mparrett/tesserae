(ns tesserae.gfx
  "The raster engine. Everything on the arena is a square *pixel*: one terminal
   cell is two pixels stacked (▀, fg = top, bg = bottom), so the arena is a
   true square that can turn through any angle.

   Coordinates:
     world units  0..48 on both axes (a tile is 2x2 units, the grid is 24x24)
     screen px    0..S-1, S = 48*k, k = integer zoom picked from terminal size
   The world is drawn through a rotation about its centre, so turning the
   field is a sampling change, not a redraw of game objects.

   Per frame:
     1. sprites add light into acc-r/g/b (screen px) and mark their cells
     2. solid overlays (paddle) write ovr (screen px) and mark cells
     3. compose! walks dirty rows/cells, samples the static layer through the
        inverse rotation, adds light, posterizes, diffs against what the
        terminal already shows, and emits only changed cells with SGR state
        tracking and short-gap bridging."
  (:require [term]))

(def ESC (str (char 27)))
(def HALF "▀")

;; ---------------------------------------------------------------------------
;; colour helpers (packed 0xRRGGBB ints)

(defn rgb [r g b]
  (bit-or (bit-or (bit-shift-left (int r) 16) (bit-shift-left (int g) 8)) (int b)))
(defn cr [c] (bit-and (bit-shift-right c 16) 255))
(defn cg [c] (bit-and (bit-shift-right c 8) 255))
(defn cb [c] (bit-and c 255))

(defn clamp8 [x] (let [x (double x)] (if (> x 255.0) 255 (if (< x 0.0) 0 (int x)))))

(defn scale [c ^double f]
  (rgb (clamp8 (* (cr c) f)) (clamp8 (* (cg c) f)) (clamp8 (* (cb c) f))))

(defn mix [a b ^double t]
  (let [s (- 1.0 t)]
    (rgb (clamp8 (+ (* s (cr a)) (* t (cr b))))
         (clamp8 (+ (* s (cg a)) (* t (cg b))))
         (clamp8 (+ (* s (cb a)) (* t (cb b)))))))

(defn add [a b]
  (rgb (clamp8 (+ (cr a) (cr b))) (clamp8 (+ (cg a) (cg b))) (clamp8 (+ (cb a) (cb b)))))

;; Posterize LUT, 6 bits/channel, endpoint preserving (shapescii ADR-021: quantize
;; *before* the diff so faint glow edges stop dirtying cells).
(def ^:private PLEVELS 63)
(def post-lut
  (let [a (int-array 256)]
    (dotimes [c 256]
      (let [inner (quot (+ (* c PLEVELS) 127) 255)]
        (aset a c (quot (+ (* inner 255) (quot PLEVELS 2)) PLEVELS))))
    a))

(defmacro post8
  "(aget post-lut (clamp8 r)) for a number r, as a tree of comparisons against
   literal thresholds (6 per channel). In AOT-lowered code with r a native
   double this stays native, where (int x) and aget would box. Level j starts
   at the integer ceil((255j - 127) / PLEVELS), and floor(r) >= t iff r >= t,
   so this matches the lut exactly."
  [r]
  (let [s (gensym "r")
        thr (fn [j] (if (zero? j) 0 (quot (+ (- (* 255 j) 127) (dec PLEVELS)) PLEVELS)))
        tree (fn tree [lo hi]
               (if (= lo hi)
                 (aget post-lut (thr lo))
                 (let [mid (quot (+ lo hi 1) 2)]
                   (list 'if (list '< s (double (thr mid))) (tree lo (dec mid)) (tree mid hi)))))]
    (list 'let [s r] (tree 0 PLEVELS))))

(defn post [r g b]
  (rgb (aget post-lut (clamp8 r)) (aget post-lut (clamp8 g)) (aget post-lut (clamp8 b))))

;; ---------------------------------------------------------------------------
;; sub-cell glyph tables (shapescii lineage)
;;
;; A cell is 1x2 square pixels. Quadrants split it 2x2, sextants 2x3. Subcell
;; (col i, row j) is bit 2j+i, so the thresholded coverage mask IS the index
;; into a 16- or 64-entry table: no codebook.

(def glyph-mode
  "0 off (balls are plain light, the v0 renderer), 1 quadrant, 2 sextant.
   Read by make-screen; set it before building a screen."
  (atom 1))

(def ^:private QUAD-CODES
  [0x20 0x2598 0x259D 0x2580 0x2596 0x258C 0x259E 0x259B
   0x2597 0x259A 0x2590 0x259C 0x2584 0x2599 0x259F 0x2588])

(defn- sextant-code
  "U+1FB00.. skips the four patterns that already exist as space, ▌, ▐, █."
  [m]
  (cond (= m 0) 0x20 (= m 63) 0x2588 (= m 21) 0x258C (= m 42) 0x2590
        :else (- (+ 0x1FB00 m -1) (if (> m 21) 1 0) (if (> m 42) 1 0))))

(defn set-glyph-mode!
  "m: :off | :quadrant | :sextant (or 0/1/2). nil keeps the current mode."
  [m]
  (when m
    (reset! glyph-mode (cond (number? m) m
                             (= m :off) 0 (= m :sextant) 2 :else 1))))

(defn- glyph-tables [mode]
  (let [codes (int-array 64) strs (object-array 64)]
    (dotimes [m 64]
      (let [cp (if (= mode 2) (sextant-code m) (nth QUAD-CODES (bit-and m 15)))]
        (aset codes m cp)
        (aset strs m (str (char cp)))))
    [codes strs]))

;; ---------------------------------------------------------------------------
;; screen

(def WORLD 48.0)
(def HALFW 24.0)

(defn make-screen
  "Layout for a terminal of tc x tr cells with a side panel of panel-w cols."
  [tc tr panel-w]
  (let [k (loop [k 4] (cond (zero? k) 0
                            (and (<= (+ (* 48 k) panel-w 2) tc) (<= (* 24 k) tr)) k
                            :else (recur (dec k))))
        k (max k 1)
        S (* 48 k)
        cols S
        rows (quot S 2)
        framed? (<= (+ rows 2) tr)
        ox (max 2 (+ 1 (quot (- tc panel-w cols) 2)))
        oy (if framed? (+ 2 (quot (- tr rows 2) 2)) 1)
        npx (* S S)
        ncell (* cols rows)
        ovr (int-array npx)
        gmode @glyph-mode
        [gcode gstr] (glyph-tables gmode)]
    (dotimes [i npx] (aset ovr i -1))
    {:k k :S S :cols cols :rows rows :ox ox :oy oy :framed? framed?
     :tc tc :tr tr :panel-x (+ ox cols 3)
     :acc-r (double-array npx) :acc-g (double-array npx) :acc-b (double-array npx)
     :ovr ovr
     :mark (int-array ncell) :pmark (int-array ncell)
     :rmark (int-array rows) :prmark (int-array rows)
     :ptop (int-array ncell) :pbot (int-array ncell) :pglyph (int-array ncell)
     :tglyph (object-array ncell) :tcol (int-array ncell)
     :gmode gmode :gcode gcode :gstr gstr  ; sub-cell sprite glyphs
     :smask (int-array ncell) :scol (int-array ncell)
     :chord (double-array 32)      ; shape-disc! scanline scratch: lo 0.., hi 16..
     :xf (double-array 16)        ; [cos sin identity?] of the field angle; 3.. the 3D table (see w->s)
     :b3 (int-array npx)          ; 3D table: lit colour per *screen* pixel (tesserae.table3d)
     :wcache (int-array npx)      ; posterized static colour per *world* pixel
     :sgr-cache (volatile! {})
     :full (atom true)
     :coarse (atom false)
     :cup-row (mapv (fn [cy] (str ESC "[" (+ oy cy) ";")) (range rows))
     :cup-col (mapv (fn [cx] (str (+ ox cx) "H")) (range cols))         ; one sample per 2x2 px block (rotation transitions)
     :stats (int-array 4)}))      ; [cells-emitted bytes dirty-cells -]

(defn too-small? [scr] (< (:tc scr) (+ 48 2 20)))

(defn set-angle!
  "Set the field angle. Rest angles (multiples of 90 degrees) snap to exact
   sin/cos so pixel centres map exactly and the cache lines up."
  [scr theta]
  (let [xf (:xf scr)
        q (/ theta (* 0.5 math/PI))
        rq (math/round q)
        snap? (< (math/abs (- q rq)) 1e-6)
        c (if snap? (nth [1.0 0.0 -1.0 0.0] (mod rq 4)) (math/cos theta))
        s (if snap? (nth [0.0 1.0 0.0 -1.0] (mod rq 4)) (math/sin theta))]
    (aset xf 0 c)
    (aset xf 1 s)
    (aset xf 2 (if (and snap? (zero? (mod rq 4))) 1.0 0.0))))

(defn cache-rect!
  "Re-sample the static layer into the world-pixel cache over the world box
   [x0,x1)x[y0,y1)."
  [scr static-fn ^double x0 ^double y0 ^double x1 ^double y1]
  (let [k (:k scr) S (:S scr) wc (:wcache scr) kinv (/ 1.0 k)
        u0 (max 0 (int (math/floor (* x0 k)))) u1 (min S (int (math/ceil (* x1 k))))
        v0 (max 0 (int (math/floor (* y0 k)))) v1 (min S (int (math/ceil (* y1 k))))]
    (loop [v v0]
      (when (< v v1)
        (let [wy (* (+ v 0.5) kinv) row (* v S)]
          (loop [u u0]
            (when (< u u1)
              (let [c (static-fn (* (+ u 0.5) kinv) wy)]
                (aset wc (+ u row) (post (cr c) (cg c) (cb c))))
              (recur (inc u)))))
        (recur (inc v))))))

(defn rebuild-cache! [scr static-fn] (cache-rect! scr static-fn 0.0 0.0 WORLD WORLD))

(defn invalidate! [scr] (reset! (:full scr) true))

;; world -> screen units (unscaled), and back. Rotation about (24,24).
(defn w->s
  "World point to screen units. With the 3D table on (xf[3] = 1, set by
   tesserae.table3d) this is a perspective projection of the point at height
   xf[15] above the tilted board: xf[4] focal F, xf[5] camera distance D,
   xf[6..14] the board rotation R (row-major)."
  [scr ^double wx ^double wy]
  (let [xf (:xf scr)]
    (if (== 1.0 (aget xf 3))
      (let [x (- wx HALFW) y (- wy HALFW) z (aget xf 15)
            X (+ (* (aget xf 6) x) (* (aget xf 7) y) (* (aget xf 8) z))
            Y (+ (* (aget xf 9) x) (* (aget xf 10) y) (* (aget xf 11) z))
            Z (+ (* (aget xf 12) x) (* (aget xf 13) y) (* (aget xf 14) z))
            q (/ (aget xf 4) (- (aget xf 5) Z))]
        [(+ HALFW (* q X)) (+ HALFW (* q Y))])
      (let [c (aget xf 0) s (aget xf 1)
            dx (- wx HALFW) dy (- wy HALFW)]
        [(+ HALFW (- (* c dx) (* s dy))) (+ HALFW (+ (* s dx) (* c dy)))]))))

(defn s->w [scr ^double sx ^double sy]
  (let [xf (:xf scr) c (aget xf 0) s (aget xf 1)
        dx (- sx HALFW) dy (- sy HALFW)]
    [(+ HALFW (+ (* c dx) (* s dy))) (+ HALFW (- (* c dy) (* s dx)))]))

(defn rot-vec
  "Rotate a vector world->screen (sign 1) or screen->world (sign -1)."
  [scr ^double vx ^double vy sign]
  (let [xf (:xf scr) c (aget xf 0) s (* sign (aget xf 1))]
    [(- (* c vx) (* s vy)) (+ (* s vx) (* c vy))]))

(defn mark-cell! [scr cx cy]
  (let [cols (:cols scr)]
    (when (and (>= cx 0) (< cx cols) (>= cy 0) (< cy (:rows scr)))
      (aset (:mark scr) (+ cx (* cy cols)) 1)
      (aset (:rmark scr) cy 1))))

(defn mark-world-rect!
  "Mark every cell covering the world-space box [x0,x1]x[y0,y1] (rotation aware)."
  [scr x0 y0 x1 y1]
  (let [k (:k scr)
        corners [(w->s scr x0 y0) (w->s scr x1 y0) (w->s scr x0 y1) (w->s scr x1 y1)]
        xs (map first corners) ys (map second corners)
        px0 (int (math/floor (* k (apply min xs)))) px1 (int (math/floor (* k (apply max xs))))
        py0 (int (math/floor (* k (apply min ys)))) py1 (int (math/floor (* k (apply max ys))))]
    (loop [cy (max 0 (quot (max 0 py0) 2))]
      (when (and (<= cy (quot py1 2)) (< cy (:rows scr)))
        (loop [cx (max 0 px0)]
          (when (and (<= cx px1) (< cx (:cols scr)))
            (mark-cell! scr cx cy)
            (recur (inc cx))))
        (recur (inc cy))))))

;; ---------------------------------------------------------------------------
;; sprites

(defn- glow*
  "glow! with the core fill `fin` and a halo scale `hs` (1.0 1.0 = glow!)."
  [scr ^double wx ^double wy ^double rad ^double core c ^double inten
   ^double fin ^double hs]
  (let [k (:k scr) S (:S scr) cols (:cols scr)
        [sx sy] (w->s scr wx wy)
        cx (* sx k) cy (* sy k)
        rpx (* rad k)
        x0 (max 0 (int (math/floor (- cx rpx)))) x1 (min (dec S) (int (math/floor (+ cx rpx))))
        y0 (max 0 (int (math/floor (- cy rpx)))) y1 (min (dec S) (int (math/floor (+ cy rpx))))
        rad2 (* rad rad) core2 (* core core)
        r (* inten (cr c)) g (* inten (cg c)) b (* inten (cb c))
        ar (:acc-r scr) ag (:acc-g scr) ab (:acc-b scr)
        mark (:mark scr) rmark (:rmark scr)
        kinv (/ 1.0 k)]
    (loop [y y0]
      (when (<= y y1)
        (let [dy (* (- (+ y 0.5) cy) kinv) dy2 (* dy dy) row (* y S) cyc (quot y 2)]
          (loop [x x0]
            (when (<= x x1)
              (let [dx (* (- (+ x 0.5) cx) kinv) d2 (+ (* dx dx) dy2)]
                (when (< d2 rad2)
                  (let [f (if (< d2 core2) fin
                              (* hs (/ core2 d2) (- 1.0 (/ d2 rad2))))
                        i (+ x row)]
                    (aset ar i (+ (aget ar i) (* r f)))
                    (aset ag i (+ (aget ag i) (* g f)))
                    (aset ab i (+ (aget ab i) (* b f)))
                    (aset mark (+ x (* cyc cols)) 1)
                    (aset rmark cyc 1))))
              (recur (inc x)))))
        (recur (inc y))))))

(defn glow!
  "Additive light: a solid core of radius `core` and a 1/d^2 halo out to `rad`
   (world units), colour c scaled by intensity. World-space position."
  [scr ^double wx ^double wy ^double rad ^double core c ^double inten]
  (glow* scr wx wy rad core c inten 1.0 1.0))

(defn shape-disc!
  "Hard-edged sub-cell silhouette of a disc (world centre, world radius).
   Each subcell is set when the disc covers at least half its area (the disc's
   chord is integrated over a few scanlines per subcell row, in screen-pixel
   space, so it follows the field's rotation). Covered cells OR their mask in;
   compose! draws them as the quadrant/sextant glyph for that mask with
   fg = bg + c (c is light added on top of the cell, like glow!'s core).
   No-op in glyph mode 0."
  [scr ^double wx ^double wy ^double rad c]
  (let [mode (:gmode scr)]
    (when (> mode 0)
      (let [k (:k scr) cols (:cols scr) rows (:rows scr)
            [sx sy] (w->s scr wx wy)
            cx (* sx k) cy (* sy k) r (* rad k) r2 (* r r)
            nr (if (= mode 2) 3 2)        ; subcell rows per cell
            sr 2                          ; scanlines per subcell row
            step (/ 2.0 nr)               ; subcell height, px
            sstep (/ step sr)
            half (* 0.25 sr)              ; half of a subcell's area, in scanline-px
            x0 (max 0 (int (math/floor (- cx r)))) x1 (min (dec cols) (int (math/floor (+ cx r))))
            y0 (quot (max 0 (int (math/floor (- cy r)))) 2)
            y1 (min (dec rows) (quot (max 0 (int (math/floor (+ cy r)))) 2))
            smask (:smask scr) scol (:scol scr) mark (:mark scr) rmark (:rmark scr)
            chord (:chord scr)]
        (loop [uy y0]
          (when (<= uy y1)
            (let [row (* uy cols) ytop (- (+ (* 2.0 uy) (* 0.5 sstep)) cy) ns (* nr sr)]
              ;; the disc's chord [lo,hi] on each scanline of this cell row
              (dotimes [q ns]
                (let [dy (+ ytop (* sstep q)) h2 (- r2 (* dy dy))
                      hw (if (> h2 0.0) (math/sqrt h2) 0.0)]
                  (aset chord q (- cx hw))
                  (aset chord (+ q 16) (+ cx hw))))
              (loop [ux x0]
                (when (<= ux x1)
                  (let [xa (* 1.0 ux) xm (+ xa 0.5) xb (+ xa 1.0)
                        m (loop [j 0 m 0]
                            (if (< j nr)
                              (let [q0 (* j sr) q1 (+ q0 sr)
                                    cl (loop [q q0 acc 0.0]
                                         (if (< q q1)
                                           (recur (inc q) (+ acc (max 0.0 (- (min (aget chord (+ q 16)) xm) (max (aget chord q) xa)))))
                                           acc))
                                    crr (loop [q q0 acc 0.0]
                                          (if (< q q1)
                                            (recur (inc q) (+ acc (max 0.0 (- (min (aget chord (+ q 16)) xb) (max (aget chord q) xm)))))
                                            acc))
                                    m (if (> cl half) (bit-or m (bit-shift-left 1 (* 2 j))) m)
                                    m (if (> crr half) (bit-or m (bit-shift-left 2 (* 2 j))) m)]
                                (recur (inc j) m))
                              m))]
                    (when (not (= 0 m))
                      (let [i (+ ux row)]
                        (aset smask i (bit-or (aget smask i) m))
                        (aset scol i c)
                        (aset mark i 1)
                        (aset rmark uy 1))))
                  (recur (inc ux)))))
            (recur (inc uy))))))))

(def ^:private BALL-HALO
  "Halo scale for glyph-mode balls: the glyph carries the bright core, so the
   halo starts dimmer and the silhouette reads against it."
  0.45)

(def ^:private BALL-CORE
  "Core light added over the glyph cell's bg; with the halo underneath it
   lands close to glow!'s saturated core colour."
  0.75)

(defn ball!
  "A ball: same arguments as glow!. Glyph mode 0 is exactly glow!; otherwise
   the halo goes to the light buffer (dimmed, flat inside the core) and the
   core becomes a sub-cell glyph silhouette."
  [scr ^double wx ^double wy ^double rad ^double core c ^double inten]
  (if (= 0 (:gmode scr))
    (glow* scr wx wy rad core c inten 1.0 1.0)
    (let [edge (* BALL-HALO (- 1.0 (/ (* core core) (* rad rad))))]
      (glow* scr wx wy rad core c inten edge BALL-HALO)
      (shape-disc! scr wx wy core (scale c (* BALL-CORE inten))))))

(defn rect!
  "Solid rectangle in *screen frame* units (not rotated), horizontally
   anti-aliased so a paddle at a fractional x still moves smoothly."
  [scr ^double x0 ^double y0 ^double x1 ^double y1 c]
  (let [k (:k scr) S (:S scr) cols (:cols scr)
        px0 (* x0 k) px1 (* x1 k)
        ix0 (max 0 (int (math/floor px0))) ix1 (min (dec S) (int (math/floor px1)))
        iy0 (max 0 (int (math/floor (* y0 k)))) iy1 (min (dec S) (dec (int (math/ceil (* y1 k)))))
        ovr (:ovr scr) ar (:acc-r scr) ag (:acc-g scr) ab (:acc-b scr)
        mark (:mark scr) rmark (:rmark scr)]
    (loop [y iy0]
      (when (<= y iy1)
        (let [cyc (quot y 2)]
          (loop [x ix0]
            (when (<= x ix1)
              (let [cov (- (min (+ x 1.0) px1) (max (* 1.0 x) px0))
                    i (+ x (* y S))]
                (if (>= cov 0.98)
                  (aset ovr i c)
                  (when (> cov 0.0)
                    (aset ar i (+ (aget ar i) (* cov 0.9 (cr c))))
                    (aset ag i (+ (aget ag i) (* cov 0.9 (cg c))))
                    (aset ab i (+ (aget ab i) (* cov 0.9 (cb c))))))
                (aset mark (+ x (* cyc cols)) 1)
                (aset rmark cyc 1))
              (recur (inc x)))))
        (recur (inc y))))))

(defn text!
  "Overlay a string on arena cells starting at cell (cx,cy). Glyph bg is the
   pixel colour beneath, so text floats over the field."
  [scr cx cy s c]
  (let [cols (:cols scr) n (count s)]
    (when (and (>= cy 0) (< cy (:rows scr)))
      (dotimes [j n]
        (let [x (+ cx j)]
          (when (and (>= x 0) (< x cols))
            (let [i (+ x (* cy cols))]
              (aset (:tglyph scr) i (subs s j (inc j)))
              (aset (:tcol scr) i c)
              (mark-cell! scr x cy))))))))

(defn world-text!
  "Centre text on a world position (follows the field's rotation)."
  [scr wx wy s c]
  (let [k (:k scr) [sx sy] (w->s scr wx wy)]
    (text! scr (- (int (* sx k)) (quot (count s) 2)) (quot (int (* sy k)) 2) s c)))

;; ---------------------------------------------------------------------------
;; compose + emit

(defn- sgr-str [cache c bg?]
  (let [key (if bg? (- -1 c) c)]
    (or (get @cache key)
        (let [s (str ESC (if bg? "[48;2;" "[38;2;") (cr c) ";" (cg c) ";" (cb c) "m")]
          (vswap! cache assoc key s)
          s))))

(defn- sgr-fg [^StringBuilder sb c]
  (.append sb ESC) (.append sb "[38;2;") (.append sb (cr c)) (.append sb ";")
  (.append sb (cg c)) (.append sb ";") (.append sb (cb c)) (.append sb "m"))
(defn- sgr-bg [^StringBuilder sb c]
  (.append sb ESC) (.append sb "[48;2;") (.append sb (cr c)) (.append sb ";")
  (.append sb (cg c)) (.append sb ";") (.append sb (cb c)) (.append sb "m"))

;; compose!'s per-pixel arithmetic, as fns of ^double/^long params: in
;; AOT-lowered Go those are native, where the same code inline in compose!
;; computes on boxed values (array reads, closure locals) and allocates per op.

(defmacro ^:private K
  "The value of constant var s, inlined as a literal."
  [s]
  @(ns-resolve 'tesserae.gfx s))

(defn- rot-sample
  "Static layer at screen pixel (x, y) through the rotation (c, s): the
   cached world pixel under it, or outside."
  [wc outside ^long x ^long y ^long S ^long k ^double kinv ^double c ^double s]
  (let [X (- (* (+ x 0.5) kinv) (K HALFW)) Y (- (* (+ y 0.5) kinv) (K HALFW))
        wx (+ (K HALFW) (+ (* c X) (* s Y))) wy (+ (K HALFW) (- (* c Y) (* s X)))]
    (if (or (< wx 0.0) (>= wx (K WORLD)) (< wy 0.0) (>= wy (K WORLD)))
      outside
      (aget wc (+ (int (* wx k)) (* (int (* wy k)) S))))))

(defn- post-add
  "(post (+ (cr base) lr) (+ (cg base) lg) (+ (cb base) lb))"
  ^long [^long base ^double lr ^double lg ^double lb]
  (bit-or (bit-or (bit-shift-left (post8 (+ (bit-and (bit-shift-right base 16) 255) lr)) 16)
                  (bit-shift-left (post8 (+ (bit-and (bit-shift-right base 8) 255) lg)) 8))
          (post8 (+ (bit-and base 255) lb))))

(defn compose!
  "Diff and emit the arena into sb. static-fn: (wx wy) -> packed colour; only
   used for the outside colour here (the static layer comes from the cache).
   Fills (:stats scr) = [cells-emitted bytes dirty-cells]."
  [scr static-fn ^StringBuilder sb]
  (let [S (:S scr) cols (:cols scr) rows (:rows scr)
        ox (:ox scr) oy (:oy scr)
        full? @(:full scr)
        outside (let [c (static-fn -1.0 -1.0)] (post (cr c) (cg c) (cb c)))
        ovr (:ovr scr)
        mark (:mark scr) pmark (:pmark scr) rmark (:rmark scr) prmark (:prmark scr)
        ptop (:ptop scr) pbot (:pbot scr) pglyph (:pglyph scr)
        tglyph (:tglyph scr) tcol (:tcol scr)
        smask (:smask scr) scol (:scol scr) gcode (:gcode scr) gstr (:gstr scr)
        cache (:sgr-cache scr)
        stats (:stats scr)
        start-len (.length sb)
        k (:k scr) kinv (/ 1.0 k)
        xf (:xf scr) c (aget xf 0) s (aget xf 1) ident? (== 1.0 (aget xf 2))
        t3? (== 1.0 (aget xf 3)) b3 (:b3 scr)   ; 3D table: base comes from b3
        wc (:wcache scr)
        ar (:acc-r scr) ag (:acc-g scr) ab (:acc-b scr)
        px (fn [x y]
             (let [i (+ x (* y S))
                   o (aget ovr i)
                   base (cond
                          (>= o 0) o
                          t3? (aget b3 i)
                          ident? (aget wc i)
                          :else (rot-sample wc outside x y S k kinv c s))
                   lr (aget ar i) lg (aget ag i) lb (aget ab i)]
               (if (and (== lr 0.0) (== lg 0.0) (== lb 0.0))
                 base
                 (do (aset ar i 0.0) (aset ag i 0.0) (aset ab i 0.0)
                     (post-add base lr lg lb)))))
        coarse? @(:coarse scr)
        ;; loop state in int slots (lowers to native aget/aset under AOT):
        ;; 0 prev-top  1 fg  2 bg  3 last-i  4 emitted  5 dirty
        v (int-array 6)
        cup-row (:cup-row scr) cup-col (:cup-col scr)]
    (aset v 1 -1) (aset v 2 -1) (aset v 3 -100)
    (when full?
      (dotimes [i (alength ptop)] (aset ptop i -1) (aset pglyph i 0)))
    (loop [cy 0]
      (when (< cy rows)
        (when (or full? (= 1 (aget rmark cy)) (= 1 (aget prmark cy)))
          (let [base-i (* cy cols) y0 (* 2 cy) y1 (inc y0)]
            (loop [cx 0]
              (when (< cx cols)
                (let [i (+ cx base-i)]
                  (when (or full? (= 1 (aget mark i)) (= 1 (aget pmark i)))
                    (aset v 5 (inc (aget v 5)))
                    (let [top (if coarse?
                                (if (= 1 (bit-and cx 1))
                                  (aget v 0)
                                  (let [t (px cx y0)] (aset v 0 t) t))
                                (px cx y0))
                          bot (if coarse? top (px cx y1))
                          tg (aget tglyph i)
                          sm (if tg 0 (aget smask i))
                          ;; sprite glyphs diff on code AND colour (bits 21+)
                          ;; text diffs on glyph AND colour too, so fades redraw
                          gl (if tg (bit-or (int (first tg)) (bit-shift-left (aget tcol i) 21))
                                 (if (= 0 sm) 0x2580
                                     (bit-or (aget gcode sm) (bit-shift-left (aget scol i) 21))))]
                      (aset ovr (+ cx (* y0 S)) -1)
                      (aset ovr (+ cx (* y1 S)) -1)
                      ;; coarse frames skip pixels; drop their light so none goes stale
                      (when coarse?
                        (let [j (+ cx (* y1 S))] (aset ar j 0.0) (aset ag j 0.0) (aset ab j 0.0))
                        (when (= 1 (bit-and cx 1))
                          (let [j (+ cx (* y0 S))] (aset ar j 0.0) (aset ag j 0.0) (aset ab j 0.0))))
                      (when (not (and (= top (aget ptop i)) (= bot (aget pbot i))
                                      (= gl (aget pglyph i))))
                        (aset ptop i top) (aset pbot i bot) (aset pglyph i gl)
                        (aset v 4 (inc (aget v 4)))
                        (when (or (= 0 cx) (not (= i (inc (aget v 3)))))
                          (.append sb (nth cup-row cy))
                          (.append sb (nth cup-col cx)))
                        (aset v 3 i)
                        (if tg
                          (let [tc (aget tcol i)
                                avg (rgb (quot (+ (cr top) (cr bot)) 2)
                                         (quot (+ (cg top) (cg bot)) 2)
                                         (quot (+ (cb top) (cb bot)) 2))]
                            (when (not (= tc (aget v 1))) (.append sb (sgr-str cache tc false)) (aset v 1 tc))
                            (when (not (= avg (aget v 2))) (.append sb (sgr-str cache avg true)) (aset v 2 avg))
                            (.append sb tg))
                          (if (= 0 sm)
                          (if (= top bot)
                            (do (when (not (= bot (aget v 2))) (.append sb (sgr-str cache bot true)) (aset v 2 bot))
                                (.append sb " "))
                            (do (when (not (= top (aget v 1))) (.append sb (sgr-str cache top false)) (aset v 1 top))
                                (when (not (= bot (aget v 2))) (.append sb (sgr-str cache bot true)) (aset v 2 bot))
                                (.append sb HALF)))
                          ;; sprite glyph: bg = the darker pixel, fg = bg + sprite light
                          (let [sc (aget scol i)
                                bc (if (< (+ (cr top) (cg top) (cb top)) (+ (cr bot) (cg bot) (cb bot)))
                                     top bot)
                                fc (post (+ (cr bc) (cr sc)) (+ (cg bc) (cg sc)) (+ (cb bc) (cb sc)))]
                            (when (not (= fc (aget v 1))) (.append sb (sgr-str cache fc false)) (aset v 1 fc))
                            (when (not (= bc (aget v 2))) (.append sb (sgr-str cache bc true)) (aset v 2 bc))
                            (.append sb (aget gstr sm))))))
                      (aset tglyph i nil)
                      (aset smask i 0)))
                  (aset pmark i (aget mark i))
                  (aset mark i 0))
                (recur (inc cx))))))
        (aset prmark cy (aget rmark cy))
        (aset rmark cy 0)
        (recur (inc cy))))
    (reset! (:full scr) false)
    (aset stats 0 (aget v 4))
    (aset stats 1 (- (.length sb) start-len))
    (aset stats 2 (aget v 5))
    nil))

;; ---------------------------------------------------------------------------
;; terminal helpers for non-arena UI (panel, cards)

(defn at [^StringBuilder sb col row]
  (.append sb ESC) (.append sb "[") (.append sb row) (.append sb ";")
  (.append sb col) (.append sb "H"))

(defn fg! [^StringBuilder sb c] (sgr-fg sb c))
(defn bg! [^StringBuilder sb c] (sgr-bg sb c))
(defn reset-sgr! [^StringBuilder sb] (.append sb ESC) (.append sb "[0m"))

(def begin-sync (str ESC "[?2026h"))
(def end-sync (str ESC "[?2026l"))

(defn present!
  "Write a built frame atomically (DEC 2026 synchronized output)."
  [^StringBuilder sb]
  (term/write (str begin-sync (.toString sb) end-sync))
  (term/flush))
