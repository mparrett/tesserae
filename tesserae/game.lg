(ns tesserae.game
  "Rules, physics and the frame loop.

   Frames of reference: tiles and balls live in the *world* (which can turn);
   the paddle, gravity and tilt live in the *screen* frame (where the player
   stands). Collisions with the paddle are done by mapping the ball into the
   screen frame and back, so the field can rotate under a moving ball."
  (:require [term] [async]
            [tesserae.gfx :as gfx]
            [tesserae.world :as w]
            [tesserae.input :as in]
            [tesserae.levels :as L]
            [tesserae.meta :as M]
            [clojure.string :as str]))

;; ---------------------------------------------------------------------------
;; constants

(def DT (/ 1.0 240.0))     ; physics step
(def BR 0.72)              ; ball radius (world units)
(def PADDLE-Y 46.0)        ; top surface of the bottom trowel (screen frame)
(def TOP-Y 2.0)            ; bottom surface of the top trowel
(def PADDLE-W 9.0)
(def PANEL-W 26)
(def TAU (* 2.0 math/PI))

(def mat-color {:spark 0xffd27a :rubber 0xff5fb0 :lead 0x9fb4d8 :marble 0xdfe8ff})

;; ---------------------------------------------------------------------------
;; state

(def scr (atom nil))
(def S (atom {}))
(def opts (atom {}))
(def quit? (atom false))
(def fps-stat (atom [0.0 0 0]))

(defn lvl [] (:level @S))
(defn lv [k] (get (lvl) k))

(defn theme [] (get L/themes (or (lv :theme) :indigo)))

;; meta layer hooks (defined in the "meta layer" section near the end)
(declare meta-won! meta-over! meta-epilogue! meta-init! meta-unlocked?
         meta-clear-tick! meta-clear-key! meta-overlay! meta-title-panel! meta-hud! meta-controls-row)

;; ---------------------------------------------------------------------------
;; small helpers

(defn clampf [x lo hi] (if (< x lo) lo (if (> x hi) hi x)))
(defn len [x y] (math/sqrt (+ (* x x) (* y y))))
(defn rnd [lo hi] (+ lo (* (rand) (- hi lo))))

(defn float-text!
  "Score popup at a world point; stored in screen units so it rises 'up'."
  [wx wy s c]
  (let [[sx sy] (gfx/w->s @scr wx wy)]
    (swap! S update :floats conj {:x sx :y sy :s s :c c :life 1.1 :max 1.1})))

(defn banner! [s c secs] (swap! S assoc :banner s :banner-c c :banner-t secs))

(defn burst! [wx wy c n spd]
  (swap! S update :parts
         (fn [ps]
           (let [ps (if (> (count ps) 160) (subvec ps (- (count ps) 120)) ps)]
             (into ps (for [_ (range n)]
                        (let [a (rnd 0 TAU) v (rnd (* 0.3 spd) spd) life (rnd 0.35 0.9)]
                          {:x wx :y wy :vx (* v (math/cos a)) :vy (* v (math/sin a))
                           :c c :life life :max life})))))))

(defn add-score! [n] (swap! S update :score + n))

;; ---------------------------------------------------------------------------
;; frames of reference

(defn open-sides
  "World sides a ball may leave through right now."
  []
  (cond
    (= :open (lv :boundary)) #{:left :right :top :bottom}
    (lv :tilt) #{}
    (:rot @S) #{}
    :else
    (let [th (:theta @S) s (math/sin th) c (math/cos th)
          down (cond (> c 0.5) :bottom (< c -0.5) :top (> s 0.5) :right :else :left)
          opp {:bottom :top :top :bottom :left :right :right :left}]
      (if (lv :twin) #{down (opp down)} #{down}))))

(defn paddle-level? [] (not (or (lv :tilt) (lv :ward))))

;; ---------------------------------------------------------------------------
;; ball construction

(defn new-ball [x y vx vy mat]
  {:x x :y y :vx vx :vy vy :mat mat :lead-t 0.0 :stuck nil :trail []})

(defn base-speed [b]
  (* (or (lv :speed) 24.0) (if (= :rubber (:mat b)) 1.3 1.0)))

(defn stuck-ball []
  (assoc (new-ball 24.0 40.0 0.0 0.0 :spark) :stuck (rnd -1.5 1.5)))

;; ---------------------------------------------------------------------------
;; the grout core (6.2), part 1: colours and core hits. Level keys:
;;   :core {:hp n}   :shield {:rings [...] :regen s}   :neutral {:rows [y0 y1]}
;;   :destroyer {:speed :fall :delay}   :swirl {:every :warn :speed}

(defn hue
  "Cheap rainbow: h in [0,1) around the wheel, v = brightness."
  [h v]
  (let [f (fn [o] (int (* 255.0 v (+ 0.5 (* 0.5 (math/cos (* TAU (- h o))))))))]
    (gfx/rgb (f 0.0) (f 0.3333) (f 0.6667))))

(defn core-colour [t hp hp0]
  (let [rate (+ 3.0 (* 6.0 (- 1.0 (/ hp (max 1.0 hp0)))))]
    (gfx/mix 0xff3a20 0xffd070 (+ 0.5 (* 0.5 (math/sin (* t rate)))))))

(defn core-broken! []
  (let [st @S]
    (doseq [i (:core-tiles st)]
      (let [[cx cy] (w/tile-center i)]
        (w/clear! i)
        (burst! cx cy 0xffd070 24 28.0)))
    (doseq [r (:rings st) i (:path r)]
      (when (= w/SHIELD (aget w/tt i))
        (let [[cx cy] (w/tile-center i)]
          (w/clear! i)
          (burst! cx cy 0xa89c88 4 14.0))))
    (add-score! 1000)
    (swap! S assoc :dest nil :swirl nil :swirl-warn nil :stun 0.0)))

(defn core-hit! [i]
  (let [[cx cy] (w/tile-center i)]
    (if (or (pos? (:core-cd @S)) (<= (:core-hp @S) 0))
      (burst! cx cy 0xffb060 4 8.0)
      (let [hp (dec (:core-hp @S))]
        (swap! S assoc :core-hp hp :core-cd 0.3 :core-flash 0.25 :goal-dirty true
               :regen-t (max (:regen-t @S 0.0) 4.0))   ; the core reels: no mending
        (add-score! 150)
        (float-text! cx cy (if (pos? hp) (str "CORE " hp) "CORE BROKEN") 0xffd070)
        (burst! cx cy 0xffa040 18 20.0)
        (when (<= hp 0) (core-broken!))))))

;; ---------------------------------------------------------------------------
;; tile hits -> rules

(defn piece-done! [i p types word bonus]
  (do
    (when (and (pos? p) (zero? (w/piece-left p types)))
      (let [[cx cy] (w/tile-center i)]
        (add-score! bonus)
        (float-text! cx cy (str word " +" bonus) 0xfff2a0)
        (burst! cx cy (aget w/tbase i) 26 22.0)
        (swap! S update :sets inc)))))

(defn hit-tile!
  "Apply a hit on tile i. Returns a ball effect keyword or nil."
  [i]
  (let [t (aget w/tt i)
        [cx cy] (w/tile-center i)
        c (aget w/tbase i)
        piece (aget w/tpiece i)
        combo (:combo @S)
        mult (+ 1.0 (* 0.5 (quot combo 5)))
        brk (fn [pts]
              (w/clear! i)
              (swap! S update :combo inc)
              (let [p (int (* pts mult))]
                (add-score! p)
                (when (> mult 1.0) (float-text! cx cy (str "+" p) c)))
              (burst! cx cy c 9 14.0)
              (swap! S assoc :goal-dirty true))]
    (cond
      (or (= t w/NORM) (= t w/RUBBER) (= t w/LEAD) (= t w/MITO))
      (do (brk 10)
          (when (= t w/NORM) (piece-done! i piece #{w/NORM} "SET" 100))
          (case t 5 :split 6 :rubber 7 :lead nil))

      (or (= t w/HARD) (= t w/MAGNET))
      (if (> (aget w/thits i) 1)
        (do (w/crack! i) (burst! cx cy c 4 8.0) nil)
        (do (brk 25) nil))

      (= t w/LAMP)
      (do (brk 50) (burst! cx cy 0xfff0a0 30 26.0)
          (float-text! cx cy "LIT" 0xfff0a0) nil)

      (= t w/SHIELD) (do (brk 15) nil)

      (= t w/CORE) (do (core-hit! i) nil)

      (= t w/GHOST)
      ;; the whole tetromino snaps into place, Tetris-style
      (let [mates (if (pos? piece)
                    (w/indices-where-i (fn [j] (and (= w/GHOST (aget w/tt j)) (= piece (aget w/tpiece j)))))
                    [i])]
        (doseq [j mates]
          (w/set-ghost! j)
          (let [[x y] (w/tile-center j)] (burst! x y (aget w/tbase j) 6 10.0)))
        (add-score! (* 15 (count mates)))
        (swap! S assoc :goal-dirty true)
        (piece-done! i piece #{w/GHOST} "LAID" 120)
        nil)

      :else (do (burst! cx cy 0x8090a0 2 6.0)
                (when (and (lv :ward) (= t w/WALL)) (swap! S assoc :combo 0))
                nil))))

;; ---------------------------------------------------------------------------
;; physics

(defn- overlapping
  "Solid tiles overlapped by a ball at (x,y)."
  [x y]
  (let [tx0 (int (math/floor (* 0.5 (- x BR)))) tx1 (int (math/floor (* 0.5 (+ x BR))))
        ty0 (int (math/floor (* 0.5 (- y BR)))) ty1 (int (math/floor (* 0.5 (+ y BR))))]
    (loop [ty ty0 acc nil]
      (if (> ty ty1) acc
          (recur (inc ty)
                 (loop [tx tx0 acc acc]
                   (if (> tx tx1) acc
                       (recur (inc tx)
                              (let [t (w/tile-at tx ty)]
                                (if (w/solid-type? t) (conj (or acc []) (+ tx (* ty w/G))) acc))))))))))

(def pierceable #{1 2 5 6 7 10})

(defn- axis-move
  "Move ball along one axis (0 = x, 1 = y). Returns updated ball; collects
   ball effects into the :fx vector on the ball."
  [b axis dt]
  (let [kp (if (zero? axis) :x :y) kv (if (zero? axis) :vx :vy)
        np (+ (get b kp) (* (get b kv) dt))
        nb (assoc b kp np)
        hits (overlapping (:x nb) (:y nb))]
    (if (nil? hits)
      nb
      (let [lead? (and (= :lead (:mat b)) (every? #(contains? pierceable (aget w/tt %)) hits))
            effects (doall (map hit-tile! hits))
            b (update b :fx into (remove nil? effects))]
        (if lead?
          nb
          (let [rest (if (lv :tilt) 0.55 1.0)]
            (assoc b kv (* -1.0 rest (get b kv)))))))))

(defn- walls
  "World boundary: reflect on closed sides."
  [b open]
  (let [{:keys [x y vx vy]} b
        lo BR hi (- 48.0 BR)
        rest (if (lv :tilt) 0.55 1.0)
        b (cond (and (< x lo) (neg? vx) (not (open :left))) (assoc b :x lo :vx (* rest (- vx)))
                (and (> x hi) (pos? vx) (not (open :right))) (assoc b :x hi :vx (* rest (- vx)))
                :else b)
        {:keys [y vy]} b]
    (cond (and (< y lo) (neg? vy) (not (open :top))) (assoc b :y lo :vy (* rest (- vy)))
          (and (> y hi) (pos? vy) (not (open :bottom))) (assoc b :y hi :vy (* rest (- vy)))
          :else b)))

(defn- paddle-bounce
  "Bounce off the trowel(s), computed in the screen frame."
  [b]
  (let [sc @scr
        [sx sy] (gfx/w->s sc (:x b) (:y b))
        [svx svy] (gfx/rot-vec sc (:vx b) (:vy b) 1)
        {px :x pv :v} (:paddle @S)
        hw (* 0.5 PADDLE-W)
        mag? (pos? (:mag-t @S 0.0))
        bounce (fn [dir surface]
                 ;; dir -1 = launch upwards (bottom trowel), +1 downwards (top)
                 (let [off (clampf (/ (- sx px) hw) -1.0 1.0)
                       sp (max (len svx svy) (base-speed b))
                       ang (* off 1.05)
                       nvx (+ (* sp (math/sin ang)) (* 0.12 pv))
                       nvy (* dir sp (math/cos ang))
                       f (/ sp (len nvx nvy))
                       nvx (* f nvx) nvy (* f nvy)
                       nsy (- surface (* -1 dir BR))
                       [wx wy] (gfx/s->w sc sx (if (neg? dir) (- surface BR) (+ surface BR)))
                       [wvx wvy] (gfx/rot-vec sc nvx nvy -1)]
                   (swap! S assoc :combo 0)
                   (if (and mag? (neg? dir))
                     (assoc b :x wx :y wy :vx 0.0 :vy 0.0 :stuck (- sx px))
                     (assoc b :x wx :y wy :vx wvx :vy wvy))))]
    (cond
      (and (pos? svy) (>= (+ sy BR) PADDLE-Y) (<= (- sy BR) (+ PADDLE-Y 1.0))
           (<= (math/abs (- sx px)) (+ hw BR)))
      (bounce -1.0 PADDLE-Y)
      (and (lv :twin) (neg? svy) (<= (- sy BR) TOP-Y) (>= (+ sy BR) (- TOP-Y 1.0))
           (<= (math/abs (- sx px)) (+ hw BR)))
      (bounce 1.0 TOP-Y)
      :else b)))

(defn- forces
  "Acceleration on a ball (world frame)."
  [b]
  (let [sc @scr
        g (or (lv :gravity) 0.0)
        g (if (= :lead (:mat b)) (* 1.8 g) g)
        [gx gy] (if (pos? g) (gfx/rot-vec sc 0.0 g -1) [0.0 0.0])
        [tx ty] (if (lv :tilt)
                  (let [[a c] (:tilt @S)] [(* 40.0 a) (* 40.0 c)])
                  [0.0 0.0])
        ;; lodestones
        [mx my] (reduce (fn [[ax ay] [lx ly]]
                          (let [dx (- lx (:x b)) dy (- ly (:y b)) d2 (+ (* dx dx) (* dy dy))]
                            (if (< d2 220.0)
                              (let [f (/ 900.0 (+ d2 8.0)) d (math/sqrt d2)]
                                [(+ ax (* f (/ dx d))) (+ ay (* f (/ dy d)))])
                              [ax ay])))
                        [0.0 0.0] (:lodes @S))
        ;; trowel lodestone
        [px py] (if (pos? (:mag-t @S 0.0))
                  (let [[sx sy] (gfx/w->s sc (:x b) (:y b))
                        dx (- (:x (:paddle @S)) sx) dy (- PADDLE-Y sy)]
                    (if (< (len dx dy) 26.0)
                      (gfx/rot-vec sc (* 6.0 dx) (* 6.0 dy) -1)
                      [0.0 0.0]))
                  [0.0 0.0])]
    (let [[sx sy] (if-let [ss (seq (:singers @S))]
                    (let [[cx cy] (apply min-key (fn [[x y]] (len (- x (:x b)) (- y (:y b)))) ss)
                          dx (- cx (:x b)) dy (- cy (:y b)) d (max 1.0 (len dx dy))]
                      [(* 14.0 (/ dx d)) (* 14.0 (/ dy d))])
                    [0.0 0.0])]
      [(+ gx tx mx px sx) (+ gy ty my py sy)])))

(defn step-ball
  "One physics step. Returns the ball (maybe with :fx) or nil when lost."
  [b dt open]
  (if (:stuck b)
    b
    (let [[ax ay] (forces b)
          b (assoc b :vx (+ (:vx b) (* ax dt)) :vy (+ (:vy b) (* ay dt)))
          b (if (lv :tilt)
              (let [f (- 1.0 (* 0.45 dt)) v (len (:vx b) (:vy b)) cap 42.0
                    f (if (> v cap) (* f (/ cap v)) f)]
                (assoc b :vx (* f (:vx b)) :vy (* f (:vy b))))
              b)
          b (-> b (axis-move 0 dt) (axis-move 1 dt) (walls open))
          b (if (paddle-level?) (paddle-bounce b) b)
          {:keys [x y]} b
          tile (w/tile-at (int (math/floor (* 0.5 x))) (int (math/floor (* 0.5 y))))]
      (cond
        (= tile w/PIT) (assoc b :lost :pit)
        (or (< x -3.0) (> x 51.0) (< y -3.0) (> y 51.0)) (assoc b :lost :out)
        (and (paddle-level?) (not (:rot @S))
             (let [[_ sy] (gfx/w->s @scr x y)]
               (or (> sy 49.5) (and (lv :twin) (< sy -1.5)))))
        (assoc b :lost :out)
        :else b))))

(defn normalize-speed
  "Paddle levels without gravity keep a constant speed per material, and the
   screen-vertical component never drops below 30% (no endless horizontals)."
  [b]
  (cond
    (or (:stuck b) (lv :tilt)) b
    (lv :gravity)
    (let [sp (len (:vx b) (:vy b)) cap (* 1.8 (base-speed b))]
      (if (> sp cap) (assoc b :vx (* (:vx b) (/ cap sp)) :vy (* (:vy b) (/ cap sp))) b))
    :else
      (let [sp (len (:vx b) (:vy b))
            target (base-speed b)]
        (if (< sp 0.01) b
            (let [f (/ target sp)
                  vx (* f (:vx b)) vy (* f (:vy b))]
              (if (paddle-level?)
                (let [sc @scr
                      [svx svy] (gfx/rot-vec sc vx vy 1)
                      min-y (* 0.3 target)]
                  (if (< (math/abs svy) min-y)
                    (let [nsy (if (neg? svy) (- min-y) min-y)
                          nsx (* (if (neg? svx) -1.0 1.0) (math/sqrt (- (* target target) (* nsy nsy))))
                          [wx wy] (gfx/rot-vec sc nsx nsy -1)]
                      (assoc b :vx wx :vy wy))
                    (assoc b :vx vx :vy vy)))
                (assoc b :vx vx :vy vy)))))))

(defn apply-fx
  "Turn the :fx a ball collected this step into ball changes / new balls."
  [b]
  (let [fx (:fx b) b (dissoc b :fx)]
    (if (empty? fx) [b]
        (reduce
         (fn [bs e]
           (let [b (first bs)]
             (case e
               :rubber (do (float-text! (:x b) (:y b) "RUBBER" 0xff5fb0)
                           (cons (assoc b :mat :rubber) (rest bs)))
               :lead (do (float-text! (:x b) (:y b) "LEAD" 0x9fb4d8)
                         (cons (assoc b :mat :lead :lead-t 9.0) (rest bs)))
               :split (let [a (rnd 0.35 0.6)
                            rot (fn [vx vy a] [(- (* vx (math/cos a)) (* vy (math/sin a)))
                                               (+ (* vx (math/sin a)) (* vy (math/cos a)))])
                            [v1x v1y] (rot (:vx b) (:vy b) a)
                            [v2x v2y] (rot (:vx b) (:vy b) (- a))]
                        (float-text! (:x b) (:y b) "MITOSIS" 0x7cf2b0)
                        (burst! (:x b) (:y b) 0x7cf2b0 14 16.0)
                        (concat [(assoc b :vx v1x :vy v1y)
                                 (assoc b :vx v2x :vy v2y :trail [])]
                                (rest bs)))
               bs)))
         [b] fx))))

;; ---------------------------------------------------------------------------
;; level lifecycle

(defn recount-goal! []
  (let [goal (lv :goal)
        n (case goal
            :clear (w/count-where w/breakable?)
            :build (w/count-where #(= % w/GHOST))
            :lamps (w/count-where #(= % w/LAMP))
            :heart (w/count-where w/breakable?)
            :core (max 0 (:core-hp @S 0))
            0)]
    (swap! S assoc :goal-left n :goal-dirty false
           ;; the last tesserae sing: few goal tiles left -> they call the Spark
           :singers (if (and (pos? n) (<= n 8) (not (lv :tilt)))
                      (let [pred (case goal :build #(= % w/GHOST) w/breakable?)]
                        (mapv w/tile-center (w/indices-where pred)))
                      []))))

(defn lodestones []
  (mapv w/tile-center (w/indices-where #(= % w/MAGNET))))

(declare choose-ward! boss-init!)

(defn spawn-balls! []
  (let [l (lvl) starts (:starts @S)]
    (swap! S assoc :balls
           (cond
             (:tilt l) (mapv (fn [[x y]] (new-ball x y 0.0 0.0 :marble)) starts)
             (:ward l) (mapv (fn [[x y]] (let [a (rnd 0 TAU) sp (:speed l)]
                                           (new-ball x y (* sp (math/cos a)) (* sp (math/sin a)) :spark)))
                             starts)
             :else (vec (for [j (range (or (:balls l) 1))]
                          (assoc (stuck-ball) :stuck (+ -2.0 (* 4.0 j)))))))))

(defn load-level! [li]
  (let [l (if (neg? li) L/title-level (nth L/levels li))
        th (get L/themes (:theme l))
        {:keys [starts]} (w/load-map! (:map l) th (+ 11 (max li 0)))]
    (swap! S merge
           {:li li :level l :starts starts
            :theta 0.0 :rot nil :rot-timer (or (:rotate l) 0.0) :rot-dir 1.0
            :paddle {:x 24.0 :v 0.0}
            :parts [] :floats [] :combo 0 :sets 0
            :mag-t 0.0 :mag-cd 0.0 :tilt [0.0 0.0]
            :ward -1 :ward-t 0.0 :ward-save nil
            :decay-t (or (:decay l) 0.0)
            :time 0.0 :banner nil :banner-t 0.0
            :lodes (lodestones)
            ;; meta layer: per-level bookkeeping
            :lost 0 :score0 (:score @S 0) :tally nil :over-saved false})
    (when (:core l) (boss-init! l))
    (gfx/set-angle! @scr 0.0)
    (gfx/rebuild-cache! @scr w/sample)
    (spawn-balls!)
    (when (:ward l) (choose-ward!))
    (recount-goal!)
    (gfx/invalidate! @scr)))

;; ---------------------------------------------------------------------------
;; the heart: a borrowed tile

(defn ward-colour [t]
  (gfx/mix 0xfff4e0 0xff4060 (+ 0.5 (* 0.5 (math/sin (* t 7.0))))))

(defn release-ward! []
  (let [i (:ward @S) sv (:ward-save @S)]
    (when (and (>= i 0) sv (= (aget w/tt i) w/WARD))
      (let [[t base hits] sv]
        (w/put! i t base)
        (aset w/thits i hits)))
    (swap! S assoc :ward -1 :ward-save nil)))

(defn choose-ward! []
  (release-ward!)
  (let [cands (w/indices-where w/breakable?)]
    (when (seq cands)
      (let [i (rand-nth cands)
            [cx cy] (w/tile-center i)]
        (swap! S assoc :ward i :ward-t 8.0
               :ward-save [(aget w/tt i) (aget w/tbase i) (aget w/thits i)])
        (w/put! i w/WARD 0xfff4e0)
        (float-text! cx cy "YOURS" 0xfff4e0)))))

(defn move-ward! [dx dy]
  (let [i (:ward @S)]
    (when (>= i 0)
      (let [x (+ (mod i w/G) dx) y (+ (quot i w/G) dy)
            j (+ x (* y w/G))]
        (when (and (>= x 0) (< x w/G) (>= y 0) (< y w/G) (= w/EMPTY (aget w/tt j))
                   (not-any? (fn [b] (let [bx (int (math/floor (* 0.5 (:x b))))
                                           by (int (math/floor (* 0.5 (:y b))))]
                                       (and (<= (math/abs (- bx x)) 1) (<= (math/abs (- by y)) 1)
                                            (let [[cx cy] (w/tile-center j)]
                                              (and (< (math/abs (- cx (:x b))) (+ 1.0 BR))
                                                   (< (math/abs (- cy (:y b))) (+ 1.0 BR)))))))
                             (:balls @S)))
          (w/clear! i)
          (w/put! j w/WARD 0xfff4e0)
          (swap! S assoc :ward j))))))

;; ---------------------------------------------------------------------------
;; update

(defn start-rotation! []
  (let [dir (if (< (rand) 0.5) 1.0 -1.0)
        th (:theta @S)]
    (swap! S assoc :rot {:from th :to (+ th (* dir 0.5 math/PI)) :t 0.0 :dur 1.2})
    (banner! "THE SKY TURNS" (:accent (theme)) 1.2)))

(defn ease [t] (if (< t 0.5) (* 2 t t) (- 1.0 (/ (math/pow (+ (* -2.0 t) 2.0) 2) 2.0))))

(defn update-rotation! [dt]
  (let [st @S]
    (if-let [r (:rot st)]
      (let [t (+ (:t r) dt)
            u (min 1.0 (/ t (:dur r)))
            th (+ (:from r) (* (- (:to r) (:from r)) (ease u)))]
        (if (>= u 1.0)
          (let [th (mod (:to r) TAU)
                th (* (math/round (/ th (* 0.5 math/PI))) 0.5 math/PI)]
            (swap! S assoc :rot nil :theta th :rot-timer (lv :rotate))
            (reset! (:coarse @scr) false)
            (gfx/set-angle! @scr th))
          (do (swap! S assoc :rot (assoc r :t t) :theta th)
              (reset! (:coarse @scr) (not (:fine-rotation @opts)))
              (gfx/set-angle! @scr th)))
        (gfx/invalidate! @scr))
      (when (lv :rotate)
        (let [rt (- (:rot-timer st) dt)]
          (swap! S assoc :rot-timer rt)
          (when (<= rt 0.0) (start-rotation!)))))))

(defn autopilot
  "Paddle target for --autoplay and the title attract mode."
  []
  (let [sc @scr
        threats (for [b (:balls @S) :when (not (:stuck b))
                      :let [[sx sy] (gfx/w->s sc (:x b) (:y b))
                            [vx vy] (gfx/rot-vec sc (:vx b) (:vy b) 1)]]
                  [sx sy vx vy])
        down (filter (fn [[_ _ _ vy]] (pos? vy)) threats)
        pick (if (seq down) (apply max-key second down) (first threats))]
    (if pick
      (let [[sx sy vx vy] pick
            ;; lead the ball to the paddle line, folding wall bounces
            tt (if (pos? vy) (/ (- PADDLE-Y sy) vy) 0.0)
            x (+ sx (* vx (min tt 1.5)))
            x (let [m (mod x 96.0)] (if (> m 48.0) (- 96.0 m) m))
            hw (* 0.5 PADDLE-W)
            ;; aim: send the bounce at the front row of what's left
            pred (if (= :build (lv :goal)) #(= % w/GHOST) w/breakable?)
            goals (when (and (pos? vy) (< tt 0.6)) (w/indices-where pred))
            aim (or (:aim @S)
                    (when (seq goals)
                      (let [i (rand-nth goals) [wx wy] (w/tile-center i)] (gfx/w->s sc wx wy))))
            _ (if (and (pos? vy) (< tt 0.6)) (swap! S assoc :aim aim) (swap! S assoc :aim nil))
            off (if aim
                  (let [[tx ty] aim ang (math/atan2 (- tx x) (- PADDLE-Y ty))]
                    (clampf (/ ang 1.05) -0.85 0.85))
                  0.0)]
        (- x (* off hw)))
      24.0)))

;; ---------------------------------------------------------------------------
;; the grout core (6.2), part 2: shield, neutral zone, destroyer, swirl.
;; The destroyer and the swirl live in the screen frame (where the trowel is);
;; the shield and core are tiles; the neutral band is tinted background tiles.

(defn nz-band
  "Screen-frame y range [y0 y1) of the neutral zone, or nil."
  []
  (when-let [{[r0 r1] :rows} (lv :neutral)] [(* 2.0 r0) (* 2.0 (inc r1))]))

(defn nz-tint! [i h]
  (let [y (quot i w/G) b (gfx/mix (:bg0 (theme)) (:bg1 (theme)) (/ y 23.0))]
    (aset w/bgc i (gfx/mix b (hue h 1.0) 0.32))))

(defn boss-init! [l]
  (let [cores (w/indices-where #(= % w/CORE))
        cs (map w/tile-center cores)
        n (max 1 (count cs))
        rings (mapv (fn [r] (assoc r :path (mapv (fn [[x y]] (+ x (* y w/G))) (L/ring-path (:box r)))
                                   :t (:step r)))
                    (get-in l [:shield :rings]))]
    (doseq [i cores] (aset w/tpiece i 9999))   ; one joined block
    (doseq [r rings i (:path r)]
      (when (= w/SHIELD (aget w/tt i)) (w/put! i w/SHIELD (:colour r))))
    (when-let [{[r0 r1] :rows} (:neutral l)]
      (doseq [y (range r0 (inc r1)) x (range w/G)]
        (nz-tint! (+ x (* y w/G)) (+ (/ x 24.0) (* 0.15 y)))))
    (doseq [i cores] (w/changed! i))
    (swap! S assoc
           :core-tiles cores
           :core-c [(/ (reduce + (map first cs)) n) (/ (reduce + (map second cs)) n)]
           :core-hp (get-in l [:core :hp] 6) :core-hp0 (get-in l [:core :hp] 6)
           :core-cd 0.0 :core-flash 0.0
           :rings rings :regen-t (get-in l [:shield :regen] 3.0)
           :nz-t 0.0
           :dest nil :dest-t (get-in l [:destroyer :delay] 3.0)
           :swirl nil :swirl-warn nil :swirl-t (get-in l [:swirl :every] 12.0)
           :stun 0.0)))

(defn scroll-ring!
  "Advance every shield cell one step along the ring. Only cells whose
   occupancy changes are touched, through w/put! / w/clear!."
  [{:keys [path dir colour]}]
  (let [n (count path)
        occ (mapv (fn [i] (= w/SHIELD (aget w/tt i))) path)]
    (dotimes [j n]
      (let [src (nth occ (mod (- j dir) n)) cur (nth occ j) i (nth path j)]
        (cond (and src (not cur) (= w/EMPTY (aget w/tt i))) (w/put! i w/SHIELD colour)
              (and cur (not src)) (w/clear! i)
              :else nil)))))

(defn ball-near? [i r]
  (let [[cx cy] (w/tile-center i)]
    (some (fn [b] (< (len (- (:x b) cx) (- (:y b) cy)) r)) (:balls @S))))

(defn regen-shield! []
  (let [cands (vec (for [r (:rings @S) :when (:regen r) i (:path r)
                         :when (and (= w/EMPTY (aget w/tt i)) (not (ball-near? i 2.6)))]
                     [i (:colour r)]))]
    (when (seq cands)
      (let [[i c] (rand-nth cands) [cx cy] (w/tile-center i)]
        (w/put! i w/SHIELD c)
        (burst! cx cy 0x8a8070 8 9.0)))))

(defn swirl-hit! [sx]
  (let [[wx wy] (gfx/s->w @scr sx PADDLE-Y)]
    (burst! wx wy 0xff5030 34 26.0)
    (swap! S update :lost inc)                     ; meta: no "unbroken" bonus
    (let [st (swap! S update :lives dec)]
      (if (<= (:lives st) 0)
        (do (swap! S assoc :mode :over :mode-t 0.0)
            (banner! "THE GROUT SETTLES" 0xff6070 99.0))
        (banner! "SWIRLED · SPARK LOST" 0xff7080 1.6)))))

(defn threat-window? [] (let [st @S] (boolean (or (:swirl st) (:swirl-warn st)))))

(defn update-destroyer! [dt live?]
  (let [cfg (lv :destroyer) sc @scr st @S d (:dest st)
        px (:x (:paddle st)) hw (* 0.5 PADDLE-W)]
    (if d
      (let [sp (:speed cfg 7.0)
            want (clampf (* 1.5 (- px (:x d))) (- sp) sp)
            vx (+ (:vx d) (* (- want (:vx d)) (min 1.0 (* dt 2.5))))
            x (clampf (+ (:x d) (* vx dt)) 1.0 47.0)
            y (+ (:y d) (* (:fall cfg 5.0) dt))
            [wx wy] (gfx/s->w sc x y)
            shot (some (fn [b] (and (not (:stuck b)) (< (len (- (:x b) wx) (- (:y b) wy)) (+ BR 1.1))))
                       (:balls st))
            gone (fn [] (swap! S assoc :dest nil :dest-t (:delay cfg 3.0)))]
        (cond
          shot (do (burst! wx wy 0xc8a8ff 16 18.0) (add-score! 50)
                   (float-text! wx wy "+50" 0xc8a8ff) (gone))
          (and (>= y (- PADDLE-Y 0.9)) (<= y (+ PADDLE-Y 1.6)) (<= (math/abs (- x px)) (+ hw 0.9)))
          (do (burst! wx wy 0xc8a8ff 14 14.0)
              (when-not (threat-window?)
                (swap! S assoc :stun 1.0)
                (float-text! wx (- wy 2.0) "STUNNED" 0xffe070))
              (gone))
          (> y 49.0) (gone)
          :else (swap! S assoc :dest (assoc d :x x :y y :vx vx))))
      (when live?
        (let [t (- (:dest-t st) dt)]
          (if (<= t 0.0)
            (let [[cx cy] (:core-c st) [sx sy] (gfx/w->s sc cx cy)]
              (burst! cx cy 0xc8a8ff 10 10.0)
              (swap! S assoc :dest {:x sx :y (+ sy 2.0) :vx 0.0}))
            (swap! S assoc :dest-t t)))))))

(defn update-swirl! [dt live?]
  (let [cfg (lv :swirl) sc @scr st @S
        px (:x (:paddle st)) hw (* 0.5 PADDLE-W)]
    (cond
      (:swirl st)
      (let [sw (:swirl st)
            x (+ (:x sw) (* (:vx sw) dt)) y (+ (:y sw) (* (:vy sw) dt))
            line (- PADDLE-Y 0.6)
            done (fn [] (swap! S assoc :swirl nil :swirl-t (:every cfg 12.0)))]
        (cond
          (and (< (:y sw) line) (>= y line) (<= (math/abs (- x px)) (+ hw 0.7)))
          (do (done) (swirl-hit! x))
          (> y 49.0) (let [[wx wy] (gfx/s->w sc x 47.5)]
                       (burst! wx wy 0xff7040 12 14.0) (done))
          :else (swap! S assoc :swirl (assoc sw :x x :y y :spin (+ (:spin sw) (* 14.0 dt))))))

      (:swirl-warn st)
      (let [t (- (:swirl-warn st) dt)]
        (if (> t 0.0)
          (swap! S assoc :swirl-warn t)
          (let [[cx cy] (:core-c st) [sx sy] (gfx/w->s sc cx cy)
                dx (- px sx) dy (- PADDLE-Y sy) d (len dx dy) sp (:speed cfg 36.0)]
            (swap! S assoc :swirl-warn nil
                   :swirl {:x sx :y sy :vx (* sp (/ dx d)) :vy (* sp (/ dy d)) :spin 0.0 :tx px}))))

      live?
      (let [t (- (:swirl-t st) dt)]
        (if (and (<= t 0.0) (<= (:stun st) 0.0))
          (do (swap! S assoc :swirl-warn (:warn cfg 1.2))
              (banner! "THE CORE GATHERS" 0xff6040 (:warn cfg 1.2)))
          (swap! S assoc :swirl-t t)))
      :else nil)))

(defn update-neutral! [dt]
  (let [[y0 y1] (nz-band) sc @scr {[r0 r1] :rows} (lv :neutral) t (:time @S)
        nt (- (:nz-t @S) dt)]
    ;; shimmer: recolour a few band tiles at a time (cheap; they re-cache)
    (if (<= nt 0.0)
      (do (dotimes [_ 5]
            (let [x (rand-int w/G) y (+ r0 (rand-int (inc (- r1 r0)))) i (+ x (* y w/G))]
              (nz-tint! i (+ (/ x 24.0) (* 0.4 t) (rnd -0.12 0.12)))
              (w/changed! i)))
          (swap! S assoc :nz-t 0.06))
      (swap! S assoc :nz-t nt))
    ;; a Spark crossing into the band takes a random spin and a rainbow trail
    (swap! S update :balls
           (fn [bs]
             (mapv (fn [b]
                     (if (:stuck b) b
                         (let [[_ sy] (gfx/w->s sc (:x b) (:y b))
                               in? (and (>= sy y0) (< sy y1))
                               rb (max 0.0 (- (:rainbow b 0.0) dt))]
                           (cond
                             (and in? (not (:nz b)))
                             (let [a (* (if (< (rand) 0.5) -1.0 1.0) (rnd 0.12 0.32))
                                   c (math/cos a) s (math/sin a)]
                               (assoc b :nz true :rainbow 1.8
                                      :vx (- (* c (:vx b)) (* s (:vy b)))
                                      :vy (+ (* s (:vx b)) (* c (:vy b)))))
                             (and (not in?) (:nz b)) (assoc b :nz false :rainbow rb)
                             :else (assoc b :rainbow rb)))))
                   bs)))))

(defn update-boss! [dt]
  (let [st @S t (:time st)
        live? (and (seq (:balls st)) (not-any? :stuck (:balls st)))]
    (swap! S assoc
           :core-cd (max 0.0 (- (:core-cd st) dt))
           :core-flash (max 0.0 (- (:core-flash st) dt))
           :stun (max 0.0 (- (:stun st) dt)))
    ;; the core pulses; faster as it weakens, white on a hit, strobing on a warning
    (when (pos? (:core-hp st))
      (let [warn (:swirl-warn st)
            c (cond (pos? (:core-flash st)) 0xffffff
                    warn (if (even? (int (* 10.0 warn))) 0xffffff 0xff2010)
                    :else (core-colour t (:core-hp st) (:core-hp0 st)))]
        (doseq [i (:core-tiles st)]
          (aset w/tbase i c) (aset w/tdot i (gfx/mix c 0xffffff 0.45))
          (aset w/thl i (gfx/mix c 0xffffff 0.6)) (aset w/tsh i (gfx/scale c 0.55))
          (w/changed! i))))
    ;; the shield scrolls and mends
    (swap! S update :rings
           (fn [rs] (mapv (fn [r] (let [rt (- (:t r) dt)]
                                    (if (<= rt 0.0)
                                      (do (scroll-ring! r) (assoc r :t (+ rt (:step r))))
                                      (assoc r :t rt))))
                          rs)))
    (when (lv :shield)
      (let [rt (- (:regen-t @S) dt)]
        (if (<= rt 0.0)
          (do (regen-shield!) (swap! S assoc :regen-t (get-in (lvl) [:shield :regen] 3.0)))
          (swap! S assoc :regen-t rt))))
    (when (lv :neutral) (update-neutral! dt))
    (when (lv :destroyer) (update-destroyer! dt live?))
    (when (lv :swirl) (update-swirl! dt live?))))

(defn boss-dodge
  "Autopilot: step out from under the swirl and the destroyer."
  [x]
  (let [st @S hw (* 0.5 PADDLE-W)
        away (fn [x hx gap]
               (if (< (math/abs (- x hx)) gap)
                 (let [l (- hx gap 1.0) r (+ hx gap 1.0)]
                   (if (or (> r (- 48.0 hw)) (and (>= l hw) (< x hx))) l r))
                 x))
        x (if-let [sw (:swirl st)]
            (let [tt (/ (- PADDLE-Y (:y sw)) (max 1.0 (:vy sw)))]
              (away x (+ (:x sw) (* (:vx sw) tt)) (+ hw 2.5)))
            x)
        x (if-let [d (:dest st)]
            (if (> (:y d) 34.0) (away x (:x d) (+ hw 2.0)) x)
            x)]
    x))

(defn update-paddle! [dt]
  (let [p (:paddle @S)
        hw (* 0.5 PADDLE-W)
        auto? (or (:autoplay @opts) (neg? (:li @S)))
        mx @in/mouse-x
        sc @scr
        target (cond
                 auto? (if (lv :core) (boss-dodge (autopilot)) (autopilot))
                 (and @in/mouse-moved mx) (/ (- mx (:ox sc) -0.5) (:k sc))
                 :else nil)
        ax (in/axis [:left :a :h] [:right :d :l])
        v (if target
            (clampf (* 14.0 (- target (:x p))) -110.0 110.0)
            (let [want (* ax 62.0)]
              (+ (:v p) (* (- want (:v p)) (min 1.0 (* dt 22.0))))))
        v (if (pos? (:stun @S 0.0)) 0.0 v)
        x (clampf (+ (:x p) (* v dt)) hw (- 48.0 hw))
        v (if (or (= x hw) (= x (- 48.0 hw))) 0.0 v)]
    (when (not= 0 ax) (reset! in/mouse-moved false))
    (swap! S assoc :paddle {:x x :v v})))

(defn tilt-path
  "BFS over tiles from (x,y) to the nearest lamp, around walls and pits
   (breakable tiles count as passable: the marble knocks them loose).
   Returns the tile index sequence or nil."
  [x y]
  (let [G w/G
        start (+ (int (* 0.5 x)) (* G (int (* 0.5 y))))
        prev (int-array w/N)]
    (dotimes [i w/N] (aset prev i -2))
    (aset prev start -1)
    (loop [q (conj clojure.lang.PersistentQueue/EMPTY start)]
      (when-let [i (peek q)]
        (if (= w/LAMP (aget w/tt i))
          (loop [j i acc ()] (if (= j -1) (vec acc) (recur (aget prev j) (cons j acc))))
          (let [cx (mod i G) cy (quot i G)
                nbrs (for [[dx dy] [[1 0] [-1 0] [0 1] [0 -1]]
                           :let [nx (+ cx dx) ny (+ cy dy) j (+ nx (* ny G))]
                           :when (and (>= nx 0) (< nx G) (>= ny 0) (< ny G)
                                      (= -2 (aget prev j))
                                      (let [t (aget w/tt j)]
                                        (not (or (= t w/WALL) (= t w/PIT)))))]
                       j)]
            (doseq [j nbrs] (aset prev j i))
            (recur (into (pop q) nbrs))))))))

(defn tilt-bot
  "Autoplay tilt: follow the BFS path a couple of tiles ahead with a
   velocity controller (slow and careful near pits)."
  [b]
  (let [st @S
        path (if (and (:tpath st) (< (- (:time st) (:tpath-t st 0.0)) 0.3))
               (:tpath st)
               (let [p (tilt-path (:x b) (:y b))]
                 (swap! S assoc :tpath p :tpath-t (:time st))
                 p))]
    (if (and path (> (count path) 1))
      (let [[wx wy] (w/tile-center (nth path (min 2 (dec (count path)))))
            dx (- wx (:x b)) dy (- wy (:y b)) d (max 0.5 (len dx dy))
            want 7.0
            dvx (- (* want (/ dx d)) (:vx b)) dvy (- (* want (/ dy d)) (:vy b))]
        [(clampf (/ dvx 6.0) -1.0 1.0) (clampf (/ dvy 6.0) -1.0 1.0)])
      [0.0 0.0])))

(defn update-tilt! [dt]
  (let [ax (in/axis [:left :a :h] [:right :d :l])
        ay (in/axis [:up :w :k] [:down :s :j])
        [tx ty] (:tilt @S)
        b (first (:balls @S))]
    (if (and (:autoplay @opts) b)
      (swap! S assoc :tilt (tilt-bot b))
      (let [rate (* 2.5 dt)
            mv (fn [cur a] (clampf (+ cur (* a rate)) -1.0 1.0))]
        (swap! S assoc :tilt [(mv tx ax) (mv ty ay)])))))

(defn lose-ball! [b]
  (let [[sx sy] (gfx/w->s @scr (:x b) (:y b))]
    (burst! (clampf (:x b) 1.0 47.0) (clampf (:y b) 1.0 47.0) 0xff5050 18 18.0)))

(defn life-lost! []
  (swap! S update :lost inc)                       ; meta: no "unbroken" bonus
  (if (lv :tilt)
    (do (add-score! -150)
        (banner! "MARBLE LOST  -150" 0xff7080 1.4)
        (swap! S assoc :combo 0 :tilt [0.0 0.0]
               :balls [(new-ball (first (first (:starts @S))) (second (first (:starts @S))) 0.0 0.0 :marble)]))
  (let [st (swap! S update :lives dec)]
    (if (<= (:lives st) 0)
      (do (swap! S assoc :mode :over :mode-t 0.0)
          (banner! "THE GROUT SETTLES" 0xff6070 99.0))
      (do (banner! (if (lv :tilt) "MARBLE LOST" "SPARK LOST") 0xff7080 1.4)
          (swap! S assoc :combo 0)
          (if (lv :tilt)
            (swap! S assoc :tilt [0.0 0.0] :balls [(new-ball (first (first (:starts @S))) (second (first (:starts @S)))
                                             0.0 0.0 :marble)])
            (spawn-balls!)))))))

(defn level-won! []
  (let [secs (:time @S)
        bonus (+ 500 (max 0 (int (- 1500 (* 10 secs)))))]
    (add-score! bonus)
    (release-ward!)
    (swap! S assoc :mode :clear :mode-t 0.0 :clear-bonus bonus
           :dest nil :swirl nil :swirl-warn nil :stun 0.0)
    (banner! (if (lv :core) "THE CORE IS BROKEN" "MOSAIC RESTORED") 0xfff2a0 3.0)
    (meta-won!)))

(defn step-world! [dt]
  (let [open (open-sides)
        n (max 1 (int (math/ceil (/ dt DT))))
        h (/ dt n)]
    (dotimes [_ n]
      (let [bs (:balls @S)
            stepped (mapcat (fn [b] (let [b (step-ball (assoc b :fx []) h open)]
                                      (if (:lost b) [b] (apply-fx b))))
                            bs)
            lost (filter :lost stepped)
            live (vec (remove :lost stepped))
            live (if (> (count live) 14) (subvec live 0 14) live)]
        (doseq [b lost] (lose-ball! b)
          (when (= :pit (:lost b)) (float-text! (:x b) (:y b) "FELL" 0xff7080)))
        (swap! S assoc :balls live)))
    (when (and (empty? (:balls @S)) (not= :over (:mode @S)))
      (if (neg? (:li @S)) (spawn-balls!) (life-lost!)))))

(defn update-balls-frame! [dt]
  ;; per frame: stuck balls ride the paddle, trails, lead timeout, speed
  (let [sc @scr px (:x (:paddle @S))]
    (swap! S update :balls
           (fn [bs]
             (mapv (fn [b]
                     (let [b (if-let [off (:stuck b)]
                               (let [[wx wy] (gfx/s->w sc (+ px off) (- PADDLE-Y BR 0.05))]
                                 (assoc b :x wx :y wy))
                               b)
                           b (if (= :lead (:mat b))
                               (let [t (- (:lead-t b) dt)]
                                 (if (<= t 0) (assoc b :mat :spark :lead-t 0.0) (assoc b :lead-t t)))
                               b)
                           tr (:trail b)
                           tr (conj (if (>= (count tr) 5) (subvec tr 1) tr) [(:x b) (:y b)])]
                       (normalize-speed (assoc b :trail tr))))
                   bs)))))

(defn launch! []
  (let [sc @scr]
    (swap! S update :balls
           (fn [bs]
             (mapv (fn [b]
                     (if-let [off (:stuck b)]
                       (let [sp (base-speed b)
                             a (+ (* 0.15 off) (rnd -0.25 0.25))
                             [vx vy] (gfx/rot-vec sc (* sp (math/sin a)) (* -1 sp (math/cos a)) -1)]
                         (assoc b :stuck nil :vx vx :vy vy))
                       b))
                   bs)))))

(defn update-fx! [dt]
  (swap! S update :parts
         (fn [ps] (into [] (comp (map (fn [p] (assoc p :x (+ (:x p) (* dt (:vx p)))
                                                     :y (+ (:y p) (* dt (:vy p)))
                                                     :vx (* (:vx p) 0.95) :vy (* (:vy p) 0.95)
                                                     :life (- (:life p) dt))))
                                 (filter #(pos? (:life %))))
                        ps)))
  (swap! S update :floats
         (fn [fs] (into [] (comp (map (fn [f] (assoc f :y (- (:y f) (* dt 4.0)) :life (- (:life f) dt))))
                                 (filter #(pos? (:life %))))
                        fs)))
  (swap! S update :banner-t - dt))

(defn update-play! [dt]
  (swap! S update :time + dt)
  (update-rotation! dt)
  (if (lv :tilt) (update-tilt! dt) (update-paddle! dt))
  (swap! S update :mag-t #(max 0.0 (- % dt)))
  (swap! S update :mag-cd #(max 0.0 (- % dt)))
  ;; the heart's borrowed tile
  (when (lv :ward)
    (let [t (- (:ward-t @S) dt)]
      (swap! S assoc :ward-t t)
      (when (<= t 0.0) (choose-ward!))
      (let [i (:ward @S)]
        (when (>= i 0)
          (let [c (ward-colour (:time @S))]
            (aset w/tbase i c) (aset w/tdot i c)
            (aset w/thl i (gfx/mix c 0xffffff 0.5)) (aset w/tsh i (gfx/scale c 0.6))
            (w/changed! i))))))
  ;; grout creep: a set tile loosens
  (when (lv :decay)
    (let [t (- (:decay-t @S) dt)]
      (if (<= t 0.0)
        (let [sets (w/indices-where #(= % w/SETT))]
          (when (seq sets)
            (let [i (rand-nth sets) [cx cy] (w/tile-center i)]
              (w/unset! i)
              (burst! cx cy 0x8a8070 12 10.0)
              (float-text! cx cy "CRUMBLE" 0xb0a090)
              (swap! S assoc :goal-dirty true)))
          (swap! S assoc :decay-t (lv :decay)))
        (swap! S assoc :decay-t t))))
  (when (and (:autoplay @opts) (some :stuck (:balls @S)) (> (:time @S) 0.8)) (launch!))
  (when (neg? (:li @S)) (when (some :stuck (:balls @S)) (launch!)))
  (update-balls-frame! dt)
  (when (lv :core) (update-boss! dt))
  (step-world! dt)
  (when (:goal-dirty @S) (recount-goal!))
  (when (and (= :play (:mode @S)) (zero? (:goal-left @S)))
    (if (neg? (:li @S))
      (load-level! -1)
      (level-won!))))

;; ---------------------------------------------------------------------------
;; rendering

(defn draw-boss!
  "The Grout Core's moving parts: neutral sparkle, warning, destroyer, swirl."
  [sc st t]
  (let [px (:x (:paddle st))]
    ;; neutral zone: a few rainbow sparks per frame on top of the tinted band
    (when-let [[y0 y1] (nz-band)]
      (dotimes [_ 3]
        (let [[wx wy] (gfx/s->w sc (rnd 0.0 48.0) (rnd y0 y1))]
          (gfx/glow! sc wx wy 1.2 0.3 (hue (rand) 1.0) 0.55))))
    ;; swirl warning: the core gathers light and a reticle locks onto the trowel
    (when-let [warn (:swirl-warn st)]
      (let [[cx cy] (:core-c st)
            f (- 1.0 (/ warn (:warn (lv :swirl) 1.2)))
            [rx ry] (gfx/s->w sc px (- PADDLE-Y 2.2))
            blink? (even? (int (* 10.0 warn)))]
        (gfx/glow! sc cx cy (+ 3.0 (* 4.0 f)) 1.0 0xff4020 (+ 0.25 (* 0.4 f)))
        (gfx/glow! sc rx ry 2.4 0.6 0xff3020 (if blink? 0.9 0.35))
        (gfx/world-text! sc cx (+ cy 9.5) "!! SWIRL !!" (if blink? 0xffe070 0xff4030))))
    ;; the swirl itself: a hot core with three orbiting sparks
    (when-let [sw (:swirl st)]
      (let [[wx wy] (gfx/s->w sc (:x sw) (:y sw)) a (:spin sw)]
        (gfx/glow! sc wx wy 2.6 0.8 0xffe0a0 1.0)
        (dotimes [j 3]
          (let [b (+ a (* j 2.094))]
            (gfx/glow! sc (+ wx (* 1.6 (math/cos b))) (+ wy (* 1.6 (math/sin b))) 1.3 0.35 0xff4020 0.9)))))
    ;; the destroyer: a slow violet mote with a wobbling tail
    (when-let [d (:dest st)]
      (let [[wx wy] (gfx/s->w sc (:x d) (:y d))
            [tx ty] (gfx/s->w sc (+ (:x d) (* 0.8 (math/sin (* 9.0 t)))) (- (:y d) 1.4))
            c (gfx/mix 0xa070ff 0xffffff (+ 0.5 (* 0.5 (math/sin (* 12.0 t)))))]
        (gfx/glow! sc tx ty 1.4 0.3 0x7040c0 0.6)
        (gfx/glow! sc wx wy 2.4 0.6 c 1.0)))
    ;; a stunned trowel throws sparks
    (when (pos? (:stun st))
      (let [[wx wy] (gfx/s->w sc (+ px (rnd -4.5 4.5)) (- PADDLE-Y (rnd 0.2 1.5)))]
        (gfx/glow! sc wx wy 1.0 0.25 0xffe070 0.8)))))

(defn draw-arena! [^StringBuilder sb]
  (let [sc @scr st @S t (:time st)]
    ;; balls: trail then core
    (doseq [b (:balls st)]
      (let [c (get mat-color (:mat b) 0xffd27a)
            tr (:trail b) n (count tr)
            rb? (pos? (:rainbow b 0.0))]
        (dotimes [j (dec n)]
          (let [[x y] (nth tr j) f (/ (inc j) (* 1.0 n))]
            (if rb?
              (gfx/glow! sc x y 1.6 0.5 (hue (+ (* 0.18 j) (* 1.5 t)) 1.0) (* 0.45 f))
              (gfx/glow! sc x y 1.4 0.4 c (* 0.22 f)))))
        (gfx/ball! sc (:x b) (:y b) 3.4 BR c 1.0)))
    ;; lodestone shimmer
    (doseq [[x y] (:lodes st)]
      (when (= w/MAGNET (w/tile-at (int (* 0.5 x)) (int (* 0.5 y))))
        (gfx/glow! sc x y (+ 4.0 (* 1.0 (math/sin (* 3.0 t)))) 0.0 0xd03050 0.25)))
    ;; singing tiles pulse
    (doseq [[x y] (:singers st)]
      (gfx/glow! sc x y 3.0 0.0 0xfff0c0 (+ 0.25 (* 0.2 (math/sin (+ (* 5.0 t) x))))))
    ;; the borrowed tile glows so the eye finds it
    (when (and (lv :ward) (>= (:ward st) 0))
      (let [[x y] (w/tile-center (:ward st))]
        (gfx/glow! sc x y 4.5 0.0 0xffe0e8 (+ 0.35 (* 0.2 (math/sin (* 7.0 t)))))))
    (when (and (lv :core) (= :play (:mode st))) (draw-boss! sc st t))
    ;; particles
    (doseq [p (:parts st)]
      (gfx/glow! sc (:x p) (:y p) 1.1 0.35 (:c p) (/ (:life p) (:max p))))
    ;; trowels (screen frame)
    (when (paddle-level?)
      (let [px (:x (:paddle st)) hw (* 0.5 PADDLE-W)
            mag? (pos? (:mag-t st))
            c (cond mag? (gfx/mix 0xff6a8a 0xffffff (* 0.5 (+ 1 (math/sin (* 20 t)))))
                    (pos? (:stun st 0.0)) (if (even? (int (* 14 t))) 0x5a6070 0xa8b0c0)
                    :else 0xcfe9ff)]
        (gfx/rect! sc (- px hw) PADDLE-Y (+ px hw) (+ PADDLE-Y 1.0) c)
        (when (lv :twin)
          (gfx/rect! sc (- px hw) (- TOP-Y 1.0) (+ px hw) TOP-Y c))
        (when mag?
          (let [[wx wy] (gfx/s->w sc px (- PADDLE-Y 1.5))]
            (gfx/glow! sc wx wy 7.0 0.0 0xff4070 0.35)))))
    ;; floating text (screen units)
    (let [k (:k sc)]
      (doseq [f (:floats st)]
        (let [c (gfx/scale (:c f) (min 1.0 (* 1.6 (/ (:life f) (:max f)))))]
          (gfx/text! sc (- (int (* (:x f) k)) (quot (count (:s f)) 2))
                     (quot (int (* (:y f) k)) 2) (:s f) c))))
    ;; banner
    (when (and (:banner st) (pos? (:banner-t st)))
      (let [s (str " " (:banner st) " ")]
        (gfx/text! sc (quot (- (:cols sc) (count s)) 2) (quot (:rows sc) 2) s (:banner-c st))))
    (when (and (paddle-level?) (some :stuck (:balls st)) (not (neg? (:li st))) (= :play (:mode st)))
      (let [s "SPACE · launch"]
        (gfx/text! sc (quot (- (:cols sc) (count s)) 2) (- (:rows sc) 5) s 0xa0a8c0)))
    (meta-overlay! sc st)
    (gfx/compose! sc w/sample sb)))

(def panel-cache (atom {}))

(defn panel-line! [^StringBuilder sb row s c]
  (let [sc @scr
        s (let [s (str s)] (if (> (count s) (- PANEL-W 1)) (subs s 0 (- PANEL-W 1)) s))
        s (str s (apply str (repeat (- PANEL-W (count s)) " ")))
        key [s c]]
    (when (and (<= (+ (:panel-x sc) PANEL-W) (inc (:tc sc))) (not= key (get @panel-cache row)))
      (swap! panel-cache assoc row key)
      (gfx/at sb (:panel-x sc) row)
      (gfx/bg! sb 0x000000)
      (gfx/fg! sb c)
      (.append sb s))))

(def level-keys "1234567890-")
(defn level-key-label [j] (if (< j (count level-keys)) (subs level-keys j (inc j)) " "))

(defn pips [n total] (apply str (for [i (range total)] (if (< i n) "●" "○"))))

(defn controls []
  (cond
    (neg? (:li @S)) ["SPACE  begin" "1-0 -  jump to level" "Q      quit"]
    (lv :tilt) ["←↑→↓   tilt the table" "SPACE  level it" "P pause  Q menu"]
    (lv :ward) ["←↑→↓   move your tile" "TAB    take another" "P pause  Q menu"]
    (lv :magnet) ["←→/mouse  trowel" "SPACE  launch · magnet" "P pause  Q menu"]
    :else ["←→/mouse  trowel" "SPACE  launch" "P pause  Q menu"]))

(defn draw-panel! [^StringBuilder sb]
  (let [sc @scr st @S l (lvl) top (:oy sc) acc (:accent (theme))
        title? (neg? (:li st))
        r (fn [i] (+ top i))
        goal-word (case (:goal l) :clear "tiles left" :build "ghosts left" :lamps "lamps dark" :heart "tiles left"
                    :core "core hits" "")
        [fps cells bytes] @fps-stat]
    (panel-line! sb (r 0) "T E S S E R A E" acc)
    (panel-line! sb (r 1) "──────────────────────" 0x404660)
    (if title?
      (do (panel-line! sb (r 2) "a mosaic breaker" 0x9098b0)
          (panel-line! sb (r 3) "" 0)
          (meta-title-panel! sb r))
      (do (panel-line! sb (r 2) (:chapter l) acc)
          (panel-line! sb (r 3) (str (:id l) "  " (:name l)) 0xe8ecf8)
          (panel-line! sb (r 4) "" 0)
          (panel-line! sb (r 5) (format "SCORE %10d" (:score st)) 0xfff2c0)
          (panel-line! sb (r 6) (str "SPARKS  " (pips (:lives st) 5)) 0xff9a9a)
          (panel-line! sb (r 7) (str "BALLS   " (count (:balls st))) 0xc8d0e8)
          (panel-line! sb (r 8) (str "COMBO   x" (+ 1.0 (* 0.5 (quot (:combo st) 5)))) 0xc8d0e8)
          (panel-line! sb (r 9) (str "GOAL    " (:goal-left st) " " goal-word) 0xc8d0e8)
          (panel-line! sb (r 10)
                       (cond (:rot st) "↻ TURNING"
                             (:rotate l) (str "↻ turn in " (int (math/ceil (:rot-timer st))) "s")
                             (:swirl-warn st) "!! SWIRL · MOVE !!"
                             (:swirl st) "!! SWIRL INBOUND"
                             (pos? (:stun st 0.0)) "✶ TROWEL STUNNED"
                             (:swirl l) (if (some :stuck (:balls st)) "the core waits"
                                            (str "swirl in " (int (math/ceil (:swirl-t st))) "s"))
                             (:ward l) (str "tile lent for " (int (math/ceil (:ward-t st))) "s")
                             (:decay l) (str "grout creeps " (int (math/ceil (:decay-t st))) "s")
                             (:magnet l) (if (pos? (:mag-cd st)) "magnet charging" "magnet READY")
                             (:tilt l) (let [[a c] (:tilt st)] (format "tilt %+.1f %+.1f" a c))
                             :else "")
                       (cond (and (:rotate l) (< (:rot-timer st) 3.0)) 0xffe070
                             (or (:swirl-warn st) (:swirl st))
                             (if (even? (int (* 8 (:time st)))) 0xff4030 0xffe070)
                             (pos? (:stun st 0.0)) 0xffe070
                             (and (:swirl l) (< (:swirl-t st 99.0) 3.0)) 0xffa060
                             :else acc))
          (meta-hud! sb r)))
    (let [cs (controls)]
      (doseq [[j s] (map-indexed vector cs)]
        (panel-line! sb (r (+ (meta-controls-row) j)) s 0x8890a8)))
    (when (:hud-stats @opts)
      (panel-line! sb (r (+ (meta-controls-row) 4)) (format "%2.0ffps %4dc %5.1fKB" fps cells (/ bytes 1024.0)) 0x505870))))

(defn draw-frame-border! [^StringBuilder sb]
  (let [sc @scr]
    (when (:framed? sc)
      (let [x0 (dec (:ox sc)) y0 (dec (:oy sc)) x1 (+ (:ox sc) (:cols sc)) y1 (+ (:oy sc) (:rows sc))
            st @S
            acc (:accent (theme))
            warn? (and (lv :rotate) (not (:rot st)) (< (:rot-timer st) 3.0))
            base (cond (:rot st) 0xffffff
                       warn? (if (even? (int (* 6 (:rot-timer st)))) 0xffe070 0x5a4a10)
                       :else (gfx/scale acc 0.55))
            ;; the tilt table lights the edge the marbles are rolling toward
            [tx ty] (if (lv :tilt) (:tilt st) [0.0 0.0])
            side (fn [t] (if (pos? t) (gfx/mix (gfx/scale acc 0.4) 0xffffff (min 1.0 t)) (gfx/scale acc 0.4)))
            [cl cr ct cb] (if (lv :tilt)
                            [(side (- tx)) (side tx) (side (- ty)) (side ty)]
                            [base base base base])
            key [cl cr ct cb x0 y0]]
        (when (not= key (:border-key @S))
          (swap! S assoc :border-key key)
          (gfx/bg! sb 0x000000)
          (gfx/fg! sb ct) (gfx/at sb x0 y0) (.append sb (str "╭" (apply str (repeat (:cols sc) "─")) "╮"))
          (gfx/fg! sb cb) (gfx/at sb x0 y1) (.append sb (str "╰" (apply str (repeat (:cols sc) "─")) "╯"))
          (gfx/fg! sb cl)
          (doseq [y (range (inc y0) y1)] (gfx/at sb x0 y) (.append sb "│"))
          (gfx/fg! sb cr)
          (doseq [y (range (inc y0) y1)] (gfx/at sb x1 y) (.append sb "│")))))))

;; ---------------------------------------------------------------------------
;; story cards

(defn wrap-text [s width]
  (if (str/blank? s) [""]
      (loop [words (str/split s #" ") line "" out []]
        (if (empty? words) (conj out line)
            (let [wd (first words)
                  cand (if (= line "") wd (str line " " wd))]
              (if (> (count cand) width)
                (recur (rest words) wd (conj out line))
                (recur (rest words) cand out)))))))

(defn draw-card! [^StringBuilder sb]
  (let [sc @scr st @S
        {:keys [title lines]} (:card st)
        tc (:tc sc) tr (:tr sc)
        width (min 60 (- tc 8))
        wrapped (vec (mapcat #(wrap-text % width) lines))
        shown (int (* 70 (:mode-t st)))
        x0 (max 1 (quot (- tc width) 2))
        y0 (max 2 (quot (- tr (count wrapped) 6) 2))
        acc (:card-accent st 0xffd27a)]
    (when (:card-fresh st)
      (swap! S assoc :card-fresh false)
      (gfx/reset-sgr! sb) (gfx/bg! sb 0x05050a)
      (let [blank (apply str (repeat tc " "))]
        (dotimes [y tr] (gfx/at sb 1 (inc y)) (.append sb blank))))
    (gfx/bg! sb 0x05050a)
    (gfx/at sb x0 y0) (gfx/fg! sb acc) (.append sb title)
    (gfx/at sb x0 (inc y0)) (gfx/fg! sb (gfx/scale acc 0.4))
    (.append sb (apply str (repeat (min width (count title)) "─")))
    (loop [j 0 left shown]
      (when (< j (count wrapped))
        (let [ln (nth wrapped j)
              vis (subs ln 0 (max 0 (min (count ln) left)))]
          (gfx/at sb x0 (+ y0 3 j)) (gfx/fg! sb 0xd8dcea) (.append sb vis)
          (recur (inc j) (- left (count ln) 1)))))
    (let [total (reduce + (map #(inc (count %)) wrapped))]
      (gfx/at sb x0 (+ y0 4 (count wrapped)))
      (gfx/fg! sb (if (> shown total)
                    (gfx/mix 0x303040 0xa0a8c8 (* 0.5 (+ 1 (math/sin (* 4 (:mode-t st))))))
                    0x05050a))
      (.append sb "SPACE to continue"))))

(defn show-card! [title lines accent then]
  (swap! S assoc :mode :card :mode-t 0.0 :card {:title title :lines lines}
         :card-fresh true :card-accent accent :card-then then))

;; ---------------------------------------------------------------------------
;; flow

(defn clear-screen! []
  (reset! panel-cache {})
  (swap! S assoc :border-key nil)
  (term/write (str gfx/ESC "[0m" gfx/ESC "[48;2;0;0;0m" gfx/ESC "[2J"))
  (gfx/invalidate! @scr))

(defn enter-level! [li]
  (clear-screen!)
  (load-level! li)
  (swap! S assoc :mode :play :mode-t 0.0))

(defn begin-level! [li]
  (if (>= li (count L/levels))
    (do (meta-epilogue!)
        (show-card! "EPILOGUE" L/epilogue 0xfff2a0 [:title]))
    (let [l (nth L/levels li)]
      (load-level! li)
      (show-card! (str (:chapter l) "  ·  " (:name l)) (:card l)
                  (:accent (get L/themes (:theme l))) [:level li]))))

(defn to-title! []
  (clear-screen!)
  (load-level! -1)
  (swap! S assoc :mode :play :mode-t 0.0))

(defn new-game! [li]
  (swap! S assoc :score 0 :lives 5)
  (if (zero? li)
    (show-card! "PROLOGUE" L/prologue 0xffd27a [:begin 0])
    (begin-level! li)))

(defn card-done! []
  (let [[what arg] (:card-then @S)]
    (case what
      :begin (begin-level! arg)
      :level (enter-level! arg)
      :title (to-title!)
      nil)))

(defn handle-event! [[k ev]]
  (let [st @S mode (:mode st) title? (neg? (:li st))]
    (cond
      (= k :ctrl-c) (reset! quit? true)
      (= k :resize) (do (reset! scr (gfx/make-screen (first (term/size)) (second (term/size)) PANEL-W))
                        (gfx/set-angle! @scr (:theta st))
                        (gfx/rebuild-cache! @scr w/sample)
                        (clear-screen!)
                        (when (= mode :card) (swap! S assoc :card-fresh true)))
      (= mode :card) (when (and (contains? #{:space :enter :click} k) (= ev :press))
                       (if (< (* 70 (:mode-t st)) 400)
                         (swap! S assoc :mode-t 99.0)
                         (card-done!)))
      title? (cond (contains? #{:q :esc} k) (reset! quit? true)
                   (contains? #{:space :enter :click} k) (new-game! 0)
                   (and (keyword? k) (= 1 (count (name k))))
                   (let [j (str/index-of level-keys (name k))]
                     (when (and j (< j (count L/levels)) (meta-unlocked? j)) (new-game! j)))
                   :else nil)
      (= mode :over) (cond (contains? #{:space :enter} k)
                           (do (swap! S assoc :lives 5 :score (quot (:score st) 2))
                               (enter-level! (:li st)))
                           (contains? #{:q :esc} k) (to-title!))
      (= mode :clear) (meta-clear-key! k ev)
      (= mode :pause) (cond (contains? #{:p :space} k) (swap! S assoc :mode :play :banner-t 0.0)
                            (contains? #{:q :esc} k) (to-title!))
      (= mode :play)
      (cond
        (contains? #{:q :esc} k) (to-title!)
        (= k :p) (do (swap! S assoc :mode :pause) (banner! "PAUSED" 0xffffff 1e9))
        (= k :r) (enter-level! (:li st))
        (= k (keyword "]")) (level-won!)
        (= k (keyword "[")) (life-lost!)                ; debug: lose a spark
        (contains? #{:space :click} k)
        (cond (some :stuck (:balls st)) (launch!)
              (lv :tilt) (swap! S assoc :tilt [0.0 0.0])
              (and (lv :magnet) (zero? (:mag-cd st))) (swap! S assoc :mag-t 1.4 :mag-cd 3.5)
              :else nil)
        (and (lv :ward) (= k :tab)) (do (add-score! -25) (choose-ward!))
        (lv :ward) (case k
                     (:left :a :h) (move-ward! -1 0)
                     (:right :d :l) (move-ward! 1 0)
                     (:up :w :k) (move-ward! 0 -1)
                     (:down :s :j) (move-ward! 0 1)
                     nil)
        :else nil)
      :else nil)))

(defn update! [dt]
  (swap! S update :mode-t + dt)
  (case (:mode @S)
    :play (do (update-play! dt) (update-fx! dt))
    :clear (do (update-fx! dt)
               (swap! S update :time + dt)
               (meta-clear-tick!))
    :over (do (update-fx! dt) (meta-over!))
    :pause nil
    :card nil
    nil))

(defn render! []
  (let [sb (StringBuilder.)]
    (if (= :card (:mode @S))
      (draw-card! sb)
      (do (draw-frame-border! sb)
          (draw-arena! sb)
          (let [sc @scr st (:stats sc)]
            (swap! fps-stat (fn [[f _ _]] [f (aget st 0) (aget st 1)])))
          (draw-panel! sb)))
    (gfx/present! sb)))

;; ---------------------------------------------------------------------------
;; meta layer (v1/meta): saved progress, unlocks, medals, the clear tally.
;; Storage and medal rules live in tesserae/meta.lg; this section is the glue,
;; reached through the small `meta-*` hooks declared near the top.

(def TALLY-START 0.4)   ; s into :clear before the numbers start counting
(def TALLY-COUNT 1.5)   ; s to count up
(def TALLY-AUTO 6.0)    ; s before the next level starts on its own
(def tally-done (+ TALLY-START TALLY-COUNT))

(defn fmt-time [secs]
  (let [s (int secs)] (format "%d:%02d" (quot s 60) (mod s 60))))

(defn meta-init! [o]
  (when (:reset-progress o) (M/reset-all!))
  (M/load!)
  (reset! M/saving? (not (:autoplay o)))
  (swap! S assoc :best (M/best)))

(defn meta-unlocked? [j] (M/unlocked? L/levels j (:all @opts)))

(defn meta-controls-row [] (+ 7 (count L/levels)))

(defn meta-won!
  "Called at the end of level-won!: flawless bonus, save the record, build the tally."
  []
  (let [st @S
        flawless (zero? (:lost st 0))
        _ (when flawless (add-score! M/FLAWLESS-BONUS))
        st @S
        l (lvl)
        secs (:time st)
        lscore (- (:score st) (:score0 st 0))
        facts (M/record-clear! L/levels (:li st) {:score lscore :secs secs :flawless flawless})
        best? (M/save-best! (:score st))]
    (swap! S assoc :banner-t 0.0 :best (M/best)
           :tally (merge facts {:title (:banner st) :secs secs :par (:par l) :sets (:sets st 0)
                                :bonus (:clear-bonus st 0) :lost (:lost st 0)
                                :lscore lscore :best-overall? best?}))))

(defn meta-over! []
  (when-not (:over-saved @S)
    (let [new? (M/save-best! (:score @S))]
      (swap! S assoc :over-saved true :over-best? (boolean new?) :best (M/best)))))

(defn meta-epilogue! []
  (M/save-best! (:score @S))
  (swap! S assoc :best (M/best)))

(defn meta-clear-tick! []
  ;; fireworks, kept above and below the tally text once it is up
  (when (< (rand) 0.25)
    (let [sc @scr
          [sx sy] (if (< (:mode-t @S) TALLY-START)
                    [(rnd 8 40) (rnd 8 30)]
                    [(rnd 6 42) (if (< (rand) 0.6) (rnd 2 8) (rnd 41 45))])
          [wx wy] (gfx/s->w sc sx sy)]
      (burst! wx wy (rand-nth (vals w/piece-colors)) 16 20.0)))
  (when (> (:mode-t @S) TALLY-AUTO)
    (begin-level! (inc (:li @S)))))

(defn meta-clear-key! [k ev]
  (when (= ev :press)
    (cond
      (contains? #{:space :enter :click} k)
      (let [t (:mode-t @S)]
        (cond (< t 0.3) nil                                   ; a launch press still in flight
              (< t tally-done) (swap! S assoc :mode-t tally-done)
              :else (begin-level! (inc (:li @S)))))
      (contains? #{:q :esc} k) (to-title!)
      :else nil)))

;; -- drawing ----------------------------------------------------------------

(defn- ctext! [sc row s c]
  (gfx/text! sc (quot (- (:cols sc) (count s)) 2) row s c))

(def PLATE 0x090910)

(defn- plate!
  "A dark backing plate under text rows [r0, r1] and cols [c0, c1) (cells), so
   the overlay stays readable over tiles and fireworks. One solid overlay rect."
  [sc c0 r0 c1 r1]
  (let [k (double (:k sc))]
    (gfx/rect! sc (/ (- c0 2) k) (/ (* 2.0 r0) k) (/ (+ c1 2) k) (/ (* 2.0 (inc r1)) k) PLATE)))

(defn- tally-line [label value] (format "%-11s%s" label value))

(defn- pad-to [s n] (str s (apply str (repeat (max 0 (- n (count s))) " "))))

(defn draw-tally! [sc st]
  (let [{:keys [title secs par sets bonus lost lscore medal flawless prev
                best-score? best-time? best-overall?]} (:tally st)
        mt (:mode-t st)
        f (clampf (/ (- mt TALLY-START) TALLY-COUNT) 0.0 1.0)
        done? (>= f 1.0)
        blink (even? (int (* 4 mt)))
        l (lvl)
        first? (nil? prev)
        w 30
        row0 (max 0 (- (quot (:rows sc) 2) 6))
        x0 (quot (- (:cols sc) w) 2)
        put! (fn [i s c] (gfx/text! sc x0 (+ row0 i) (pad-to s w) c))
        mark (fn [s on?] (if (and done? on? (not first?)) (str s) ""))]
    (plate! sc (- (quot (:cols sc) 2) 18) (dec row0) (+ (quot (:cols sc) 2) 18) (+ row0 13))
    (ctext! sc row0 (str " " title " ") 0xfff2a0)
    (ctext! sc (+ row0 1) (str " " (:id l) " · " (:name l) (if (and done? first?) "  · first clear " " ")) 0xb0b8d0)
    (put! 3 (str (tally-line "time" (fmt-time (* f secs)))
                 (if par (str " / par " (fmt-time par)) "")
                 (mark "  BEST" best-time?))
          (if (and done? best-time? (not first?)) 0xfff2a0 0xd8dcea))
    (put! 4 (tally-line "medal" (cond (not done?) "·"
                                      medal (str "● " (M/medal-name medal))
                                      :else "—"))
          (if (and done? medal) (M/medal-colour medal) 0xd8dcea))
    (put! 5 (tally-line (if (= :build (:goal l)) "laid" "sets") (str (int (* f sets)))) 0xd8dcea)
    (put! 6 (tally-line "time bonus" (str "+" (int (* f bonus)))) 0xd8dcea)
    (put! 7 (tally-line "unbroken" (if flawless (str "+" (int (* f M/FLAWLESS-BONUS)) " ✦")
                                       (str "— " lost " lost")))
          (if flawless 0x9bea7a 0x9098b0))
    (put! 8 (str (tally-line "level" (str (int (* f lscore)))) (mark "  BEST" best-score?))
          (if (and done? best-score? (not first?)) 0xfff2a0 0xd8dcea))
    (when (and done? best-overall?)
      (ctext! sc (+ row0 10) " NEW HIGH SCORE " (if blink 0xffd24a 0xff9a40)))
    (when done?
      (ctext! sc (+ row0 12) " SPACE to continue "
              (gfx/mix 0x505870 0xc0c8e0 (* 0.5 (+ 1 (math/sin (* 4 mt)))))))))

(defn draw-over! [sc st]
  (let [row (quot (:rows sc) 2) c0 (- (quot (:cols sc) 2) 19)]
    (plate! sc c0 (dec row) (+ c0 38) (+ row 6))
    (ctext! sc (+ row 2) (format " score %d   best %d " (:score st) (:best st 0)) 0xe8ecf8)
    (when (:over-best? st)
      (ctext! sc (+ row 3) " NEW BEST " (if (even? (int (* 4 (:mode-t st)))) 0xffd24a 0xff9a40)))
    (when (> (:mode-t st) 1.0)
      (ctext! sc (+ row 5) " SPACE retry (half score) · Q menu " 0x9098b0))))

(defn meta-overlay!
  "Arena text for the meta layer, drawn just before compose!."
  [sc st]
  (case (:mode st)
    :clear (when (:tally st) (draw-tally! sc st))
    :over (draw-over! sc st)
    nil))

(defn panel-segs!
  "Like panel-line!, but a row of [text colour] segments."
  [^StringBuilder sb row segs]
  (let [sc @scr
        segs (loop [ss segs left (dec PANEL-W) out []]
               (if (or (empty? ss) (<= left 0)) out
                   (let [[s c] (first ss) s (str s)
                         s (if (> (count s) left) (subs s 0 left) s)]
                     (recur (rest ss) (- left (count s)) (conj out [s c])))))
        n (reduce + (map #(count (first %)) segs))
        key segs]
    (when (and (<= (+ (:panel-x sc) PANEL-W) (inc (:tc sc))) (not= key (get @panel-cache row)))
      (swap! panel-cache assoc row key)
      (gfx/at sb (:panel-x sc) row)
      (gfx/bg! sb 0x000000)
      (doseq [[s c] segs] (gfx/fg! sb c) (.append sb s))
      (.append sb (apply str (repeat (- PANEL-W n) " "))))))

(defn medal-glyph
  "[glyph colour] for a level record."
  [rec]
  (cond (nil? rec) ["·" 0x505870]
        (:medal rec) ["●" (M/medal-colour (:medal rec))]
        :else ["○" 0xb0b8d0]))

(defn meta-title-panel!
  "Level list (medals, locks), best score and medal counts."
  [^StringBuilder sb r]
  (let [n (count L/levels)]
    (doseq [[j l] (map-indexed vector L/levels)]
      (let [rec (M/record (:id l))
            open? (meta-unlocked? j)
            [g gc] (medal-glyph rec)]
        (panel-segs! sb (r (+ 4 j))
                     (if open?
                       [[(str (level-key-label j) " ") 0xb0b8d0] [g gc]
                        [(if (:flawless rec) "✦" " ") 0x9bea7a]
                        [(str " " (:id l) " " (:name l)) 0xb0b8d0]]
                       [[(str (level-key-label j) " ") 0x3a4058] ["⊘" 0x5a4a50]
                        [(str "  " (:id l) " " (:name l)) 0x3a4058]]))))
    (panel-segs! sb (r (+ 4 n)) [["best  " 0x808aa0] [(str (M/best)) 0xfff2c0]])
    (let [mc (M/medal-counts)]
      (panel-segs! sb (r (+ 5 n))
                   (if @M/ok?
                     (vec (mapcat (fn [m] [["●" (M/medal-colour m)] [(str (get mc m 0) "  ") 0x808aa0]])
                                  [:gold :silver :bronze]))
                     [["progress not saved" 0x805050]])))))

(defn meta-hud!
  "In-level rows: time against par (coloured by the medal it is on pace for)
   and this level's saved best."
  [^StringBuilder sb r]
  (let [st @S l (lvl) par (:par l)
        t (if (= :clear (:mode st)) (:secs (:tally st) 0.0) (:time st))   ; frozen at the clear
        pace (M/medal t par)]
    (panel-segs! sb (r 11) [["time    " 0x808aa0]
                            [(fmt-time t) (if pace (M/medal-colour pace) 0xc8d0e8)]
                            [(if par (str " / par " (fmt-time par)) "") 0x808aa0]])
    (let [rec (M/record (:id l)) [g gc] (medal-glyph rec)]
      (panel-segs! sb (r 12)
                   (if rec
                     [["best    " 0x808aa0] [g gc] [(str " " (:score rec) " · " (fmt-time (:time rec))) 0x808aa0]]
                     [["best    —" 0x505870]])))))

;; ---------------------------------------------------------------------------
;; main loop

(defn wire-world! []
  (reset! w/on-change
          (fn [tx ty]
            (let [x0 (* 2.0 tx) y0 (* 2.0 ty) sc @scr]
              (gfx/cache-rect! sc w/sample x0 y0 (+ x0 2.0) (+ y0 2.0))
              (gfx/mark-world-rect! sc x0 y0 (+ x0 1.999) (+ y0 1.999))))))

(defn main! [o]
  (reset! opts o)
  (gfx/set-glyph-mode! (get o :glyphs :quadrant))
  (let [[tc tr] (or (term/size) [100 30])]
    (reset! scr (gfx/make-screen tc tr PANEL-W)))
  (wire-world!)
  (reset! S {:score 0 :lives 5 :mode :play :mode-t 0.0 :best 0})
  (meta-init! o)
  (term/raw-mode!)
  (term/alternate-screen)
  (term/hide-cursor)
  (term/write (str gfx/ESC "[?7l"))
  (in/start!)
  (try
    (clear-screen!)
    (if-let [li (:level o)]
      (do (swap! S assoc :score 0 :lives 5)
          (if (:skip-card o) (enter-level! li) (begin-level! li)))
      (to-title!))
    (let [fps (or (:fps o) 50)
          frame-ns (/ 1e9 fps)
          t-start (System/nanoTime)
          stop-at (when-let [s (:seconds o)] (+ t-start (* s 1e9)))]
      (loop [last (System/nanoTime)]
        (let [t0 (System/nanoTime)
              dt (min 0.05 (/ (- t0 last) 1e9))]
          (doseq [e (in/poll!)] (handle-event! e))
          (update! dt)
          (render!)
          (let [el (- (System/nanoTime) t0)]
            (swap! fps-stat (fn [[_ c b]] [(/ 1e9 (max frame-ns (* 1.0 el))) c b]))
            (let [ms (/ (- frame-ns el) 1e6)]
              (when (> ms 1.0) (async/<!! (async/timeout (long ms))))))
          (when-not (or @quit? (and stop-at (> (System/nanoTime) stop-at)))
            (recur t0)))))
    (finally
      (in/stop!)
      (term/write (str gfx/ESC "[0m" gfx/ESC "[?7h" gfx/ESC "[?2026l"))
      (term/show-cursor)
      (term/main-screen)
      (term/restore-mode!))))
